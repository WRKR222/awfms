generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ─────────────────────────────────────────────────────────────────

enum UserRole {
  ATTENDANT
  MANAGER
  ACCOUNTANT
  OWNER
  SALES
  STORE
  SECURITY1
  SECURITY2
}

enum BatchStage {
  BROODING   // 0-6 weeks
  GROWER     // 6-18 weeks
  PRODUCTION // 18+ weeks
  SOLD       // batch sold — all birds removed
  DISCARDED  // batch discarded/culled out
  CLOSED     // administratively closed
}

enum BirdType {
  LAYER_COMMERCIAL
  KIENYEJI
}

enum MortalityCause {
  DISEASE
  INJURY
  HEAT_STRESS
  PREDATOR
  CULLED_SICK
  CULLED_LOW_PRODUCTIVITY
  CULLED_OVERPOPULATION
  UNKNOWN
}

enum EntryStatus {
  PENDING
  APPROVED
  RETURNED
}

enum EggGrade {
  SMALL
  MEDIUM
  LARGE
  EXTRA_LARGE
  REJECT
}

enum FeedType {
  CHICK_MASH
  GROWER_MASH
  LAYER_MASH
  KIENYEJI_STARTER
  KIENYEJI_GROWER
  KIENYEJI_FINISHER
}

enum HealthEventType {
  DISEASE_OUTBREAK
  INJURY
  ROUTINE_CHECKUP
  MEDICATION
  QUARANTINE_IMPOSED
  QUARANTINE_LIFTED
  CULLING
  BIRD_MORTALITY
  BIRD_SOLD
  BATCH_SOLD
  BATCH_DISCARDED
  WEIGHING
}

enum VaccinationRoute {
  DRINKING_WATER
  EYE_DROP
  INJECTION
  SPRAY
  WING_WEB
  OTHER
}

enum SalesTier {
  TIER_1 // 1-10 trays
  TIER_2 // 11+ trays
}

enum PaymentMethod {
  CASH
  MPESA
  BANK
  CREDIT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERING
  DELIVERED
  RETURNED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum NotificationType {
  FEED_LOW_STOCK
  MORTALITY_ANOMALY
  VERIFICATION_PENDING
  OVERDUE_INVOICE
  VACCINATION_DUE
  AI_REPORT_READY
  ENTRY_RETURNED
  EGG_TALLY_TRIGGERED
  STOCK_LOCKED_BOOKING
  BOOKING_CANCELLED
  SYSTEM
  PURCHASE_REQUEST
  PRICING_SET
  // Issuance Plan notifications
  ISSUANCE_PLAN_SUBMITTED
  ISSUANCE_PLAN_ACCOUNTANT_APPROVED
  ISSUANCE_PLAN_APPROVED
  ISSUANCE_PLAN_REJECTED
  ISSUANCE_PLAN_PENDING_REMINDER
  WEEKLY_PLAN_REMINDER
  FEED_ISSUANCE_DAILY_ALERT
  // Brooder control threshold alerts
  BROODER_FEED_OVERISSUE    // feed issued > calculated HyLine daily ration for a level
  BROODER_WEIGHT_ANOMALY    // bird weight sample outside HyLine min/max band
  BROODER_MORTALITY_HIGH    // cumulative mortality % exceeds HyLine week ceiling
}

enum IssuancePlanType {
  WEEKLY
  EMERGENCY
}

/// Plan-level workflow phase — tracks whether the plan as a whole has been
/// submitted and is in front of the Accountant/Director, independent of each
/// item's own approval outcome (see IssuancePlanItemStatus).
enum IssuancePlanPhase {
  DRAFT
  PENDING_ACCOUNTANT
  PENDING_DIRECTOR
  DECIDED   // Director has acted on every item — plan as a whole is closed out
}

/// Per-item approval status. Each line item walks the same Accountant →
/// Director chain independently, so the Director can approve some items on a
/// plan and reject others without blocking or approving the rest.
enum IssuancePlanItemStatus {
  PENDING_ACCOUNTANT
  PENDING_DIRECTOR
  APPROVED
  REJECTED
}

// ─── NEW PHASE 2 ENUMS ────────────────────────────────────────────────────

enum StoreItemCategory {
  MEDICATION
  EQUIPMENT
  FEED
  SUPPLEMENT
  FEED_SUPPLEMENT
  PACKAGING
  CLEANING
  SAFETY
  OTHER
}

enum StoreItemUnit {
  KG
  G
  L
  ML
  PIECE
  BOX
  BAG
  BOTTLE
  SACHET
  TRAY
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum ConstructionType {
  NEW_STRUCTURE
  RENOVATION
  REPAIR
  MAINTENANCE
  EXPANSION
}

// ─── BROODER CAGE MAP (Phase 9) ────────────────────────────────────────────
// The brooder is a fixed physical grid: 6 rows/decks × 4 levels (bottom→top)
// per row = 24 addressable cells. Each cell can hold its own slice of a
// batch's chick population so a problem on one level never has to be
// described as "somewhere in the brooder" — it is isolated to e.g. Row 3,
// Level 2. Heating can be charcoal (quantity tracked) or heat-bulb (on/off
// timer tracked) per row.

enum HeatSourceType {
  CHARCOAL
  HEAT_BULB
}

// ─── AUTHENTICATION & RBAC ─────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole
  fullName     String    @map("full_name")
  houseIds     String[]  @map("house_ids")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  refreshTokens           RefreshToken[]
  auditLogs               AuditLog[]
  flockEntries            FlockDailyEntry[]
  feedIntakeLogs          FeedIntakeLog[]
  productionEntries       ProductionEntry[]
  notifications           Notification[]
  createdBatches          Batch[]                 @relation("BatchCreatedBy")
  approvedEntries         FlockDailyEntry[]       @relation("FlockEntryApprovedBy")
  passwordResetsReceived  PasswordResetLog[]      @relation("PasswordResetTarget")
  passwordResetsPerformed PasswordResetLog[]      @relation("PasswordResetAdmin")
  deliveryLogsLogged      DeliveryLog[]           @relation("DeliveryLogsLogged")
  dailyPricesSet          DailyEggPrice[]
  brooderLogs             BrooderLog[]            @relation("BrooderLoggedBy")
  brooderTreatmentLogs    BrooderTreatmentLog[]   @relation("BrooderTreatmentLoggedBy")

  // Phase 4
  expenseCategories      ExpenseCategory[]       @relation("ExpenseCategoryCreatedBy")
  eggPriceSchedules      EggPriceSchedule[]      @relation("EggPriceScheduleSetBy")

  // Phase 2 new
  storeStockIns      StoreStockIn[]      @relation("StoreStockInReceivedBy")
  storeStockOuts     StoreStockOut[]     @relation("StoreStockOutIssuedBy")
  breakageAdjustments   EggBreakageAdjustment[]  @relation("BreakageAdjustmentReportedBy")

  // New model back-relations (Cage Map + Stock Requests)
  cageAssignments              BatchCageAssignment[]    @relation("CageAssignedBy")
  simpleStockRequestsRequested SimpleStockRequest[]     @relation("SimpleStockRequestedBy")
  simpleStockRequestsFulfilled SimpleStockRequest[]     @relation("SimpleStockFulfilledBy")
  dataUploadLogs               DataUploadLog[]

  // Issuance Plan relations
  issuancePlansCreated          IssuancePlan[] @relation("IssuancePlanCreatedBy")
  issuancePlanItemsAccountantApproved IssuancePlanItem[] @relation("IssuancePlanItemAccountantApproved")
  issuancePlanItemsDirectorApproved   IssuancePlanItem[] @relation("IssuancePlanItemDirectorApproved")
  issuancePlanItemsRejected           IssuancePlanItem[] @relation("IssuancePlanItemRejectedBy")
  feedConsumptionPlans          FeedConsumptionPlan[] @relation("FeedConsumptionPlanSetBy")

  // Brooder Cage Map (Phase 9)
  brooderLevelAssignments  BrooderLevelAssignment[] @relation("BrooderLevelAssignedBy")
  brooderHeatLogs          BrooderHeatLog[]         @relation("BrooderHeatLoggedBy")
  brooderLevelFeedLogs     BrooderLevelFeedLog[]    @relation("BrooderLevelFeedLoggedBy")
  brooderMortalityLogs     BrooderLevelMortalityLog[] @relation("BrooderMortalityLoggedBy")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─── FARM INFRASTRUCTURE ────────────────────────────────────────────────────

model House {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  capacity    Int
  birdType    BirdType @map("bird_type")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  batches           Batch[]
  

  @@map("houses")
}

// ─── FLOCK & BATCH MANAGEMENT ───────────────────────────────────────────────

model Supplier {
  id        String   @id @default(uuid())
  name      String
  contact   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  batches Batch[]

  @@map("suppliers")
}

model Batch {
  id                   String     @id @default(uuid())
  batchCode            String     @unique @map("batch_code")
  supplierId           String     @map("supplier_id")
  houseId              String     @map("house_id")
  birdType             BirdType   @map("bird_type")
  strain               String
  quantityReceived     Int        @map("quantity_received")
  currentBirdCount     Int        @map("current_bird_count")
  dateOfHatch          DateTime   @map("date_of_hatch")
  dateReceived         DateTime   @map("date_received")
  stage                BatchStage @default(BROODING)
  location             String     @default("PRODUCTION_HOUSE") @map("location")
  vaccinationOnArrival Boolean    @default(false) @map("vaccination_on_arrival")
  mortalityOnArrival   Int        @default(0) @map("mortality_on_arrival")
  transportConditions  String?    @map("transport_conditions")
  notes                String?
  isActive             Boolean    @default(true) @map("is_active")
  closedAt             DateTime?  @map("closed_at")
  soldAt               DateTime?  @map("sold_at")
  discardedAt          DateTime?  @map("discarded_at")
  createdById          String     @map("created_by_id")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")
  deletedAt            DateTime?  @map("deleted_at")

  supplier              Supplier               @relation(fields: [supplierId], references: [id])
  house                 House                  @relation(fields: [houseId], references: [id])
  createdBy             User                   @relation("BatchCreatedBy", fields: [createdById], references: [id])
  flockEntries          FlockDailyEntry[]
  feedIntakeLogs        FeedIntakeLog[]
  brooderLogs           BrooderLog[]
  treatmentLogs         BrooderTreatmentLog[]
  productionEntries     ProductionEntry[]
  weightSamples         BirdWeightSample[]
  vaccinationRecords    VaccinationRecord[]
  healthEvents          HealthEvent[]
  eggCollectionSessions EggCollectionSession[]
  cageAssignments       BatchCageAssignment[]
  dailyEggAggregates    DailyEggAggregate[]
  brooderLevelAssignments  BrooderLevelAssignment[]
  brooderMortalityLogs     BrooderLevelMortalityLog[]

  @@index([houseId])
  @@index([stage])
  @@index([isActive])
  @@map("batches")
}

model FlockDailyEntry {
  id                 String          @id @default(uuid())
  batchId            String          @map("batch_id")
  houseId            String          @map("house_id")
  entryDate          DateTime        @map("entry_date") @db.Date
  shift              String          @default("AM")
  openingCount       Int             @map("opening_count")
  mortalityCount     Int             @default(0) @map("mortality_count")
  mortalityCause     MortalityCause? @map("mortality_cause")
  cullingCount       Int             @default(0) @map("culling_count")
  cullingReason      String?         @map("culling_reason")
  closingCount       Int             @map("closing_count")
  waterConsumptionL  Decimal?        @map("water_consumption_l") @db.Decimal(8, 2)
  temperatureCelsius Decimal?        @map("temperature_celsius") @db.Decimal(4, 1)
  humidityPercent    Decimal?        @map("humidity_percent") @db.Decimal(4, 1)
  notes              String?
  status             EntryStatus     @default(PENDING)
  submittedById      String          @map("submitted_by_id")
  approvedById       String?         @map("approved_by_id")
  approvedAt         DateTime?       @map("approved_at")
  returnReason       String?         @map("return_reason")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  batch       Batch @relation(fields: [batchId], references: [id])
  submittedBy User  @relation(fields: [submittedById], references: [id])
  approvedBy  User? @relation("FlockEntryApprovedBy", fields: [approvedById], references: [id])

  @@unique([batchId, entryDate, shift])
  @@index([batchId, entryDate])
  @@index([status])
  @@index([submittedById])
  @@map("flock_daily_entries")
}

model BirdWeightSample {
  id             String   @id @default(uuid())
  batchId        String   @map("batch_id")
  sampleDate     DateTime @map("sample_date") @db.Date
  sampleCount    Int      @map("sample_count")
  totalWeightG   Int      @map("total_weight_g")
  averageWeightG Decimal  @map("average_weight_g") @db.Decimal(8, 2)
  ageWeeks       Int      @map("age_weeks")
  notes          String?
  recordedById   String   @map("recorded_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  batch Batch @relation(fields: [batchId], references: [id])

  @@index([batchId, sampleDate])
  @@map("bird_weight_samples")
}

// ─── FEED MANAGEMENT ─────────────────────────────────────────────────────────

model FeedDelivery {
  id            String   @id @default(uuid())
  feedType      FeedType @map("feed_type")
  supplierName  String   @map("supplier_name")
  quantityKg    Decimal  @map("quantity_kg") @db.Decimal(10, 2)
  pricePerKg    Decimal  @map("price_per_kg") @db.Decimal(10, 2)
  totalCost     Decimal  @map("total_cost") @db.Decimal(12, 2)
  deliveryDate  DateTime @map("delivery_date") @db.Date
  invoiceNumber String?  @map("invoice_number")
  notes         String?
  recordedById  String   @map("recorded_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([feedType, deliveryDate])
  @@map("feed_deliveries")
}

model FeedIntakeLog {
  id                  String      @id @default(uuid())
  batchId             String      @map("batch_id")
  houseId             String      @map("house_id")
  feedType            FeedType    @map("feed_type")
  entryDate           DateTime    @map("entry_date") @db.Date
  quantityDispensedKg Decimal     @map("quantity_dispensed_kg") @db.Decimal(8, 2)
  wastageKg           Decimal     @default(0) @map("wastage_kg") @db.Decimal(8, 2)
  recommendedMinKg    Decimal?    @map("recommended_min_kg") @db.Decimal(8, 2)
  recommendedMaxKg    Decimal?    @map("recommended_max_kg") @db.Decimal(8, 2)
  status              EntryStatus @default(PENDING)
  notes               String?
  recordedById        String      @map("recorded_by_id")
  approvedById        String?     @map("approved_by_id")
  approvedAt          DateTime?   @map("approved_at")
  returnReason        String?     @map("return_reason")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  batch      Batch @relation(fields: [batchId], references: [id])
  recordedBy User  @relation(fields: [recordedById], references: [id])

  @@unique([batchId, entryDate, feedType])
  @@index([batchId, entryDate])
  @@index([status])
  @@map("feed_intake_logs")
}

model FeedStockSnapshot {
  id              String   @id @default(uuid())
  feedType        FeedType @map("feed_type")
  snapshotDate    DateTime @map("snapshot_date") @db.Date
  stockKg         Decimal  @map("stock_kg") @db.Decimal(10, 2)
  avgDailyUsageKg Decimal  @map("avg_daily_usage_kg") @db.Decimal(8, 2)
  daysRemaining   Decimal  @map("days_remaining") @db.Decimal(6, 1)
  alertFired      Boolean  @default(false) @map("alert_fired")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([feedType, snapshotDate])
  @@map("feed_stock_snapshots")
}

// ─── HEALTH & BIOSECURITY ─────────────────────────────────────────────────

model VaccinationSchedule {
  id           String           @id @default(uuid())
  vaccineName  String           @map("vaccine_name")
  birdType     BirdType         @map("bird_type")
  ageWeeks     Int              @map("age_weeks")
  route        VaccinationRoute
  boosterWeeks Int?             @map("booster_weeks")
  isActive     Boolean          @default(true) @map("is_active")
  notes        String?
  createdAt    DateTime         @default(now()) @map("created_at")

  records VaccinationRecord[]

  @@map("vaccination_schedule")
}

model VaccinationRecord {
  id               String           @id @default(uuid())
  batchId          String           @map("batch_id")
  scheduleId       String?          @map("schedule_id")
  vaccineName      String           @map("vaccine_name")
  administeredDate DateTime         @map("administered_date") @db.Date
  route            VaccinationRoute
  batchSize        Int              @map("batch_size")
  dosageUnits      String?          @map("dosage_units")
  vetName          String?          @map("vet_name")
  notes            String?
  recordedById     String           @map("recorded_by_id")
  createdAt        DateTime         @default(now()) @map("created_at")

  batch    Batch                @relation(fields: [batchId], references: [id])
  schedule VaccinationSchedule? @relation(fields: [scheduleId], references: [id])

  @@index([batchId])
  @@map("vaccination_records")
}

model HealthEvent {
  id            String          @id @default(uuid())
  batchId       String          @map("batch_id")
  eventType     HealthEventType @map("event_type")
  eventDate     DateTime        @map("event_date") @db.Date
  affectedCount Int             @map("affected_count")
  symptoms      String?
  diagnosis     String?
  treatment     String?
  outcome       String?
  isResolved    Boolean         @default(false) @map("is_resolved")
  resolvedAt    DateTime?       @map("resolved_at")
  recordedById  String          @map("recorded_by_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  batch      Batch          @relation(fields: [batchId], references: [id])
  vetReports VetPdfReport[]

  @@index([batchId, eventDate])
  @@map("health_events")
}

model VetPdfReport {
  id            String   @id @default(uuid())
  batchId       String   @map("batch_id")
  healthEventId String?  @map("health_event_id")
  reportDate    DateTime @map("report_date") @db.Date
  vetName       String   @map("vet_name")
  summary       String
  r2Key         String   @map("r2_key")
  r2Url         String   @map("r2_url")
  fileSizeBytes Int      @map("file_size_bytes")
  uploadedById  String   @map("uploaded_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  healthEvent HealthEvent? @relation(fields: [healthEventId], references: [id])

  @@index([batchId])
  @@map("vet_pdf_reports")
}

model VisitorLog {
  id                String    @id @default(uuid())
  visitorName       String    @map("visitor_name")
  organisation      String?
  purpose           String
  checkInAt         DateTime  @map("check_in_at")
  checkOutAt        DateTime? @map("check_out_at")
  biosecurityChecks Json      @map("biosecurity_checks")
  houseId           String?   @map("house_id")
  recordedById      String    @map("recorded_by_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([checkInAt])
  @@map("visitor_log")
}


model VisitorGateLog {
  id           String   @id @default(uuid())
  visitorId    String   @map("visitor_id")
  gate         String
  action       String
  timestamp    DateTime
  recordedById String   @map("recorded_by_id")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([visitorId])
  @@index([gate, timestamp])
  @@map("visitor_gate_logs")
}

// ─── PRODUCTION TRACKING ──────────────────────────────────────────────────

model ProductionEntry {
  id             String      @id @default(uuid())
  batchId        String      @map("batch_id")
  houseId        String      @map("house_id")
  entryDate      DateTime    @map("entry_date") @db.Date
  shift          String      @default("AM")
  eggsSmall      Int         @default(0) @map("eggs_small")
  eggsMedium     Int         @default(0) @map("eggs_medium")
  eggsLarge      Int         @default(0) @map("eggs_large")
  eggsExtraLarge Int         @default(0) @map("eggs_extra_large")
  eggsReject     Int         @default(0) @map("eggs_reject")
  totalEggs      Int         @map("total_eggs")
  henDayPercent  Decimal?    @map("hen_day_percent") @db.Decimal(5, 2)
  status         EntryStatus @default(PENDING)
  notes          String?
  submittedById  String      @map("submitted_by_id")
  approvedById   String?     @map("approved_by_id")
  approvedAt     DateTime?   @map("approved_at")
  returnReason   String?     @map("return_reason")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  batch       Batch @relation(fields: [batchId], references: [id])
  submittedBy User  @relation(fields: [submittedById], references: [id])

  @@unique([batchId, entryDate, shift])
  @@index([batchId, entryDate])
  @@index([status])
  @@map("production_entries")
}

// ─── PHASE 3: EGG COLLECTION SESSION ────────────────────────────────────────

model EggCollectionSession {
  id            String      @id @default(uuid())
  batchId       String      @map("batch_id")
  houseId       String      @map("house_id")
  sessionDate   DateTime    @map("session_date") @db.Date
  shift         String
  collectedById String      @map("collected_by_id")

  openingPop    Int         @map("opening_pop")
  mortalities   Int         @default(0)
  closingStock  Int         @map("closing_stock")
  rowData       Json        @map("row_data")

  totalFullTrays  Int       @map("total_full_trays")
  totalLooseEggs  Int       @map("total_loose_eggs")
  totalBrokenEggs Int       @default(0) @map("total_broken_eggs")
  totalSoftShell  Int       @default(0) @map("total_soft_shell")
  totalDeformed   Int       @default(0) @map("total_deformed")
  totalWeightKg   Decimal   @map("total_weight_kg") @db.Decimal(8, 2)
  totalGoodEggs   Int       @map("total_good_eggs")
  totalStarterEggs   Int       @default(0) @map("total_starter_eggs")
  totalBrokenSellable Int      @default(0) @map("total_broken_sellable")
  totalBrokenUnsellable Int    @default(0) @map("total_broken_unsellable")
  feedKg              Decimal?  @map("feed_kg") @db.Decimal(8, 2)
  feedTypeName        String?   @map("feed_type_name")
  waterLiters         Decimal?  @map("water_liters") @db.Decimal(8, 2)
  houseTempC          Decimal?  @map("house_temp_c") @db.Decimal(5, 1)
  editedAt           DateTime? @map("edited_at")
  editedById         String?   @map("edited_by_id")
  deletedAt          DateTime? @map("deleted_at")
  henDayPercent   Decimal?  @map("hen_day_percent") @db.Decimal(5, 2)

  vaccineGiven  String?     @map("vaccine_given")
  dailyFeedKg   Decimal?    @map("daily_feed_kg") @db.Decimal(8, 2)
  remarks       String?

  status         EntryStatus @default(PENDING)
  returnReason   String?     @map("return_reason")
  verifiedById   String?     @map("verified_by_id")
  verifiedAt     DateTime?   @map("verified_at")

  storeSignedById String?    @map("store_signed_by_id")
  storeSignedAt   DateTime?  @map("store_signed_at")

  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

