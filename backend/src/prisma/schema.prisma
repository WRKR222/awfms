// ─── BROODER LOG ─────────────────────────────────────────────────────────────

enum BrooderLogSession {
  MORNING
  MIDDAY
  EVENING
}

model BrooderLog {
  id                String            @id @default(uuid())
  batchId           String            @map("batch_id")
  logDate           DateTime          @map("log_date") @db.Date
  logSession        BrooderLogSession? @map("log_session")
  // Environmental readings (3× daily)
  waterConsumptionL Float?   @map("water_consumption_l")
  temperature       Float?
  humidityPercent   Float?   @map("humidity_percent")
  lightIntensityLux Int?     @map("light_intensity_lux")
  lightingOk        Boolean  @default(true) @map("lighting_ok")
  // Feed & mortality removed — tracked via BrooderLevelFeedLog / BrooderLevelMortalityLog
  feedType          String?  @map("feed_type")
  feedConsumedKg    Float?   @map("feed_consumed_kg")
  mortalityCount    Int      @default(0) @map("mortality_count")
  // Vaccine with dose
  vaccineGiven      String?  @map("vaccine_given")
  vaccineGivenDose  String?  @map("vaccine_given_dose")
  // Supplement with dose
  supplement        String?
  supplementDose    String?  @map("supplement_dose")
  notes             String?
  loggedById        String   @map("logged_by_id")
  createdAt         DateTime @default(now()) @map("created_at")

  rowId   String? @map("row_id")
  levelId String? @map("level_id")

  batch    Batch          @relation(fields: [batchId], references: [id])
  loggedBy User           @relation("BrooderLoggedBy", fields: [loggedById], references: [id])
  row      BrooderRow?    @relation(fields: [rowId], references: [id])
  level    BrooderLevel?  @relation(fields: [levelId], references: [id])

  // Uniqueness constraints (enforced via partial indexes — see migration 20260626000001)
  // SESSION  logs: unique (batchId, logDate, logSession) WHERE logSession IS NOT NULL  → 3×/day max
  // DAILY    logs: unique (batchId, logDate)             WHERE logSession IS NULL      → 1×/day max
  @@index([batchId, logDate])
  @@index([rowId])
  @@index([levelId])
  @@map("brooder_logs")
}

/// Drug/treatment administered to a brooder batch, pinpointed to a row+level.
model BrooderTreatmentLog {
  id            String   @id @default(uuid())
  batchId       String   @map("batch_id")
  rowId         String?  @map("row_id")
  levelId       String?  @map("level_id")
  treatmentDate DateTime @map("treatment_date") @db.Date
  drugName      String   @map("drug_name")
  dose          String
  doseUnit      String   @default("ml") @map("dose_unit")
  route         String   @default("DRINKING_WATER")
  durationDays  Int?     @map("duration_days")
  notes         String?
  loggedById    String   @map("logged_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  batch    Batch        @relation(fields: [batchId], references: [id])
  loggedBy User         @relation("BrooderTreatmentLoggedBy", fields: [loggedById], references: [id])
  row      BrooderRow?  @relation(fields: [rowId], references: [id])
  level    BrooderLevel? @relation(fields: [levelId], references: [id])

  @@index([batchId])
  @@index([treatmentDate])
  @@map("brooder_treatment_logs")
}

/// One of the 6 fixed physical rows/decks in the brooder house.
model BrooderRow {
  id        String   @id @default(uuid())
  rowNumber Int      @unique @map("row_number") // 1-6
  label     String   // e.g. "Row 1"
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  levels        BrooderLevel[]
  heatLogs      BrooderHeatLog[]
  brooderLogs   BrooderLog[]
  treatmentLogs BrooderTreatmentLog[]

  @@map("brooder_rows")
}

/// One of the 4 fixed levels (bottom→top) within a BrooderRow.
/// levelNumber 1 = bottom, 4 = top. Each level is independently addressable
/// so an issue (disease, heat failure, etc.) can be isolated to a single
/// level without affecting the rest of the row or brooder.
model BrooderLevel {
  id          String   @id @default(uuid())
  rowId       String   @map("row_id")
  levelNumber Int      @map("level_number") // 1 (bottom) - 4 (top)
  label       String   // e.g. "Level 1 (Bottom)"
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  row              BrooderRow               @relation(fields: [rowId], references: [id], onDelete: Cascade)
  assignment       BrooderLevelAssignment?
  brooderLogs      BrooderLog[]
  feedLogs         BrooderLevelFeedLog[]
  mortalityLogs    BrooderLevelMortalityLog[]
  treatmentLogs    BrooderTreatmentLog[]

  @@unique([rowId, levelNumber])
  @@map("brooder_levels")
}

/// Which batch (and how many chicks) currently occupies a given level.
/// One active assignment per level at a time — mirrors BatchCageAssignment's
/// pattern for the production-house cage map. The whole batch can be
/// reconstructed end-to-end by following its assignments from brooder
/// level(s) through to its production-house BatchCageAssignment rows.
model BrooderLevelAssignment {
  id           String   @id @default(uuid())
  levelId      String   @unique @map("level_id")
  batchId      String   @map("batch_id")
  birdCount    Int      @default(0) @map("bird_count")
  placedDate   DateTime @map("placed_date") @db.Date
  notes        String?
  assignedById String   @map("assigned_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  level      BrooderLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  batch      Batch        @relation(fields: [batchId], references: [id])
  assignedBy User         @relation("BrooderLevelAssignedBy", fields: [assignedById], references: [id])

  @@index([batchId])
  @@map("brooder_level_assignments")
}

/// Heating record per row, per day. CHARCOAL entries track quantity (kg)
/// used; HEAT_BULB entries track how long the bulb(s) were switched on
/// (minutesOn), captured via a start/stop timer on the attendant UI.
model BrooderHeatLog {
  id              String         @id @default(uuid())
  rowId           String         @map("row_id")
  logDate         DateTime       @map("log_date") @db.Date
  sourceType      HeatSourceType @map("source_type")

  // CHARCOAL fields
  charcoalKg      Float?         @map("charcoal_kg")

  // HEAT_BULB fields — timer-tracked
  bulbStartedAt   DateTime?      @map("bulb_started_at")
  bulbStoppedAt   DateTime?      @map("bulb_stopped_at")
  bulbMinutesOn   Int?           @map("bulb_minutes_on") // derived & frozen when stopped
  bulbCount       Int?           @map("bulb_count")      // number of bulbs running

  notes           String?
  loggedById      String         @map("logged_by_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  row      BrooderRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  loggedBy User       @relation("BrooderHeatLoggedBy", fields: [loggedById], references: [id])

  @@index([rowId, logDate])
  @@index([sourceType])
  @@map("brooder_heat_logs")
}

/// Per-level feed dispensed, logged against the level's required weekly
/// ration (population × g/bird/week standard) so attendant, PM and Director
/// dashboards can all see whether the exact required amount was given.
model BrooderLevelFeedLog {
  id                  String   @id @default(uuid())
  levelId             String   @map("level_id")
  feedType            String   @map("feed_type")
  entryDate           DateTime @map("entry_date") @db.Date
  quantityDispensedKg Float    @map("quantity_dispensed_kg")
  requiredKgForWeek   Float?   @map("required_kg_for_week") // snapshot of the standard at log time
  notes               String?
  loggedById          String   @map("logged_by_id")
  createdAt           DateTime @default(now()) @map("created_at")

  level    BrooderLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  loggedBy User         @relation("BrooderLevelFeedLoggedBy", fields: [loggedById], references: [id])

  @@index([levelId, entryDate])
  @@map("brooder_level_feed_logs")
}

/// HyLine Brown rearing schedule (weeks 1-19) used as the control standard
/// for feed consumption, bird weight, and mortality rate in the brooder.
/// Seeded by migration; editable by OWNER via settings if breed changes.
/// The "Surviving Birds" and "Total Weekly Feed (Bags)" columns from the
/// original chart are excluded — they are batch-size-dependent.
model BrooderControlStandard {
  id                     String   @id @default(uuid())
  week                   Int      @unique                                              // 1-19
  deheusPhase            String   @map("deheus_phase")                                // Starter Crumbs / Grower / Developer / Prelayer
  feedingGramsPerBird    Decimal  @map("feeding_grams_per_bird")   @db.Decimal(8, 2)  // g/bird/day
  deheusWeeklyIntakeKg   Decimal  @map("deheus_weekly_intake_kg")  @db.Decimal(8, 3)  // kg/bird/week
  expectedWeightMinG     Decimal  @map("expected_weight_min_g")    @db.Decimal(10, 2) // HyLine min (g)
  expectedWeightMaxG     Decimal  @map("expected_weight_max_g")    @db.Decimal(10, 2) // HyLine max (g)
  cumulativeMortalityPct Decimal  @map("cumulative_mortality_pct") @db.Decimal(5, 2)  // cumulative % mortality ceiling
  productionTraysPerWeek Decimal? @map("production_trays_per_week") @db.Decimal(8, 2) // non-null only from week 18
  createdAt              DateTime @default(now()) @map("created_at")

  @@map("brooder_control_standards")
}

/// Mortality / culling event pinpointed to an exact brooder Row + Level.
/// On create the service:
///   1. Writes this log record (Req 1 — row, level, count).
///   2. Decrements BrooderLevelAssignment.birdCount (Req 2 — feed recalculates
///      from the updated population on the next cage-map call).
///   3. Decrements Batch.currentBirdCount.
///   4. Checks cumulative mortality % against BrooderControlStandard and
///      fires BROODER_MORTALITY_HIGH notification if exceeded (Req 7).
model BrooderLevelMortalityLog {
  id             String   @id @default(uuid())
  levelId        String   @map("level_id")
  batchId        String   @map("batch_id")
  logDate        DateTime @map("log_date") @db.Date
  mortalityCount Int      @default(0) @map("mortality_count")
  cullingCount   Int      @default(0) @map("culling_count")
  cause          String?                                         // MortalityCause enum value
  notes          String?
  loggedById     String   @map("logged_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  level    BrooderLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  batch    Batch        @relation(fields: [batchId], references: [id])
  loggedBy User         @relation("BrooderMortalityLoggedBy", fields: [loggedById], references: [id])

  @@index([levelId, logDate])
  @@index([batchId])
  @@map("brooder_level_mortality_logs")
}

// ═══════════════════════════════════════════════════════════════════════════
// ─── PHASE 2: STORE INVENTORY MANAGEMENT ─────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════

/// Master catalogue of items stocked in the store
model StoreItem {
  id          String             @id @default(uuid())
  name        String
  sku         String             @unique
  category    StoreItemCategory
  unit        StoreItemUnit
  description String?
  reorderLevel Decimal           @default(0) @map("reorder_level") @db.Decimal(10, 3)
  currentStock Decimal           @default(0) @map("current_stock") @db.Decimal(10, 3)
  unitCostKes  Decimal           @default(0) @map("unit_cost_kes") @db.Decimal(10, 2)
  supplierId   String?           @map("supplier_id")
  isActive     Boolean           @default(true) @map("is_active")
  createdById  String            @map("created_by_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  stockIns        StoreStockIn[]
  stockOuts       StoreStockOut[]
  simpleStockRequestItems SimpleStockRequestItem[]
  issuancePlanItems       IssuancePlanItem[]

  @@index([category])
  @@index([isActive])
  @@map("store_items")
}

/// Goods received into store (from purchase / delivery)
model StoreStockIn {
  id            String   @id @default(uuid())
  storeItemId   String   @map("store_item_id")
  receivedDate  DateTime @map("received_date") @db.Date
  quantityIn    Decimal  @map("quantity_in") @db.Decimal(10, 3)
  unitCostKes   Decimal  @map("unit_cost_kes") @db.Decimal(10, 2)
  totalCostKes  Decimal  @map("total_cost_kes") @db.Decimal(12, 2)
  supplierName  String?  @map("supplier_name")
  invoiceRef    String?  @map("invoice_ref")
  notes         String?
  receivedById  String   @map("received_by_id")
  expiryDate    DateTime? @map("expiry_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")

  storeItem     StoreItem           @relation(fields: [storeItemId], references: [id])
  receivedBy    User                @relation("StoreStockInReceivedBy", fields: [receivedById], references: [id])

  @@index([storeItemId, receivedDate])
  @@index([receivedDate])
  @@map("store_stock_ins")
}

/// Items issued out of store (to houses/batches)
model StoreStockOut {
  id            String   @id @default(uuid())
  storeItemId   String   @map("store_item_id")
  issuedDate    DateTime @map("issued_date") @db.Date
  quantityOut   Decimal  @map("quantity_out") @db.Decimal(10, 3)
  unitCostKes   Decimal  @map("unit_cost_kes") @db.Decimal(10, 2)
  totalCostKes  Decimal  @map("total_cost_kes") @db.Decimal(12, 2)
  issuedToName    String? @map("issued_to_name")
  issuedToHouseId String? @map("issued_to_house_id")
  issuedToBatchId String? @map("issued_to_batch_id")
  purpose       String?
  notes         String?
  issuedById    String   @map("issued_by_id")
  // Issuance plan traceability
  issuancePlanId     String? @map("issuance_plan_id")
  issuancePlanItemId String? @map("issuance_plan_item_id")
  createdAt     DateTime @default(now()) @map("created_at")

  storeItem        StoreItem                @relation(fields: [storeItemId], references: [id])
  issuedBy         User                     @relation("StoreStockOutIssuedBy", fields: [issuedById], references: [id])
  stockRequestItem SimpleStockRequestItem?
  issuancePlan     IssuancePlan?            @relation(fields: [issuancePlanId], references: [id])
  issuancePlanItem IssuancePlanItem?        @relation(fields: [issuancePlanItemId], references: [id])

  @@index([storeItemId, issuedDate])
  @@index([issuedDate])
  @@map("store_stock_outs")
}

/// Weekly or emergency issuance plan — replaces PurchaseRequest/LPO for stock issuance control
model IssuancePlan {
  id            String              @id @default(uuid())
  planRef       String              @unique @map("plan_ref")
  type          IssuancePlanType    @default(WEEKLY)
  weekStartDate DateTime            @map("week_start_date") @db.Date
  weekEndDate   DateTime            @map("week_end_date") @db.Date
  /// Plan-level phase: whether it's still a draft, with the Accountant, with
  /// the Director, or fully decided. Does NOT mean every item was approved —
  /// check each IssuancePlanItem.status for that. See `phase` computation in
  /// issuance-plan.service.ts for how this is kept in sync.
  phase         IssuancePlanPhase   @default(DRAFT)
  notes         String?
  emergencyReason String?           @map("emergency_reason")

  createdById               String    @map("created_by_id")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  createdBy            User              @relation("IssuancePlanCreatedBy", fields: [createdById], references: [id])
  items                IssuancePlanItem[]
  stockOuts            StoreStockOut[]

  @@index([phase])
  @@index([weekStartDate])
  @@index([type, phase])
  @@map("issuance_plans")
}

/// A single line item on an IssuancePlan. Each item carries its own
/// Accountant → Director approval chain, independently of its siblings —
/// the Director can approve some items on a plan and reject others.
model IssuancePlanItem {
  id              String  @id @default(uuid())
  planId          String  @map("plan_id")
  storeItemId     String  @map("store_item_id")
  /// Total quantity requested for the week (or for the emergency event)
  quantityPlanned Decimal @map("quantity_planned") @db.Decimal(10, 3)
  unitPriceKes    Decimal @map("unit_price_kes") @db.Decimal(10, 2)
  /// JSON: { MON, TUE, WED, THU, FRI, SAT, SUN } — daily kg requested; null for EMERGENCY items
  dailyBreakdown  Json?   @map("daily_breakdown")
  /// Running total issued against this plan line (incremented by each stock-out).
  /// Only items with status = APPROVED can ever have stock issued against them.
  quantityIssued  Decimal @default(0) @map("quantity_issued") @db.Decimal(10, 3)
  /// Residual balance carried forward from the previous week's approved plan.
  /// Stores deduct this from the current week's issuance so only the net
  /// required quantity is issued (Req 4 — brooder feed carry-forward).
  residualCarryForwardKg Decimal? @map("residual_carry_forward_kg") @db.Decimal(10, 3)
  /// MANUAL | PM_FEED_PLAN — auto-generated feed lines carry PM_FEED_PLAN
  source          String  @default("MANUAL") @map("source")
  notes           String?

  /// Per-item approval status — this is what the stock-out gate actually checks.
  status                 IssuancePlanItemStatus @default(PENDING_ACCOUNTANT) @map("status")
  accountantApprovedById String?                @map("accountant_approved_by_id")
  accountantApprovedAt   DateTime?              @map("accountant_approved_at")
  directorApprovedById   String?                @map("director_approved_by_id")
  directorApprovedAt     DateTime?              @map("director_approved_at")
  rejectedById           String?                @map("rejected_by_id")
  rejectedAt             DateTime?              @map("rejected_at")
  rejectionReason        String?                @map("rejection_reason")

  plan      IssuancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  storeItem StoreItem    @relation(fields: [storeItemId], references: [id])
  stockOuts StoreStockOut[]

  accountantApprovedBy User? @relation("IssuancePlanItemAccountantApproved", fields: [accountantApprovedById], references: [id])
  directorApprovedBy   User? @relation("IssuancePlanItemDirectorApproved", fields: [directorApprovedById], references: [id])
  rejectedBy           User? @relation("IssuancePlanItemRejectedBy", fields: [rejectedById], references: [id])

  @@index([planId])
  @@index([storeItemId])
  @@index([status])
  @@map("issuance_plan_items")
}

/// PM's weekly grams-per-bird-per-day input, used to auto-generate feed lines in the IssuancePlan
model FeedConsumptionPlan {
  id                 String     @id @default(uuid())
  weekStartDate      DateTime   @map("week_start_date") @db.Date
  stage              BatchStage @map("stage")
  feedType           FeedType   @map("feed_type")
  gramsPerBirdPerDay Decimal    @map("grams_per_bird_per_day") @db.Decimal(8, 2)
  setById            String     @map("set_by_id")
  createdAt          DateTime   @default(now()) @map("created_at")

  setBy User @relation("FeedConsumptionPlanSetBy", fields: [setById], references: [id])

  @@unique([weekStartDate, stage, feedType])
  @@index([weekStartDate])
  @@map("feed_consumption_plans")
}

/// Purchase request raised by Store, reviewed by Accountant
// ─── PHASE 2: FARM EMPLOYEES ──────────────────────────────────────────────────


model FarmEmployee {
  id                String         @id @default(uuid())
  fullName          String         @map("full_name")
  employeeNumber    String?        @map("employee_number")
  nationalId        String?        @unique @map("national_id")
  address           String?
  workPhone         String?        @map("work_phone")
  mobilePhone       String?        @map("mobile_phone")
  phone             String?
  email             String?
  role              String
  assignment        String?
  houseIds          String[]       @map("house_ids")
  salaryKes         Decimal        @default(0) @map("salary_kes") @db.Decimal(10, 2)
  payPeriod         String         @default("MONTHLY") @map("pay_period")
  hireDate          DateTime       @map("hire_date") @db.Date
  terminatedDate    DateTime?      @map("terminated_date") @db.Date
  status            EmployeeStatus @default(ACTIVE)
  nextOfKinName     String?        @map("next_of_kin_name")
  nextOfKinPhone    String?        @map("next_of_kin_phone")
  nextOfKinRelation String?        @map("next_of_kin_relation")
  notes             String?
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@index([status])
  @@map("farm_employees")
}


// ─── PHASE 2: CONSTRUCTION RECORDS ───────────────────────────────────────────

model ConstructionRecord {
  id               String           @id @default(uuid())
  title            String
  constructionType ConstructionType @map("construction_type")
  location         String           // house code / general farm area
  startDate        DateTime         @map("start_date") @db.Date
  endDate          DateTime?        @map("end_date") @db.Date
  contractorName   String?          @map("contractor_name")
  contractorPhone  String?          @map("contractor_phone")
  budgetKes        Decimal          @default(0) @map("budget_kes") @db.Decimal(12, 2)
  actualCostKes    Decimal          @default(0) @map("actual_cost_kes") @db.Decimal(12, 2)
  status           String           @default("IN_PROGRESS") // PLANNED | IN_PROGRESS | COMPLETED | ON_HOLD
  description      String?
  notes            String?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([status])
  @@index([startDate])
  @@map("construction_records")
}

// ─── Egg Breakage Adjustment (Sales role) ─────────────────────────────────────

model EggBreakageAdjustment {
  id             String   @id @default(uuid())
  adjustmentRef  String   @unique @map("adjustment_ref")
  adjustmentDate DateTime @map("adjustment_date") @db.Date

  // Source: STANDARD (good egg broke) | CONSUMABLE (consumable broken got destroyed)
  sourceType     String   @default("STANDARD") @map("source_type")

  // Result: NON_CONSUMABLE = unsellable | CONSUMABLE = sellable at reduced price
  adjustmentType String   @map("adjustment_type")

  // Quantities at time of adjustment (snapshot from tally / stock)
  quantityStandardBefore      Int @map("quantity_standard_before")
  quantityStarterBefore       Int @map("quantity_starter_before")
  quantityNonConsumableBefore Int @map("quantity_non_consumable_before")
  quantityConsumableBefore    Int @map("quantity_consumable_before")

  // New corrected quantities (entered by Sales)
  newStandard      Int @map("new_standard")
  newNonConsumable Int @map("new_non_consumable")
  newConsumable    Int @map("new_consumable")

  // Auto-calculated diff
  quantityDiff Int @map("quantity_diff")

  // Optional: reference tally session this is based on
  tallySessionId String? @map("tally_session_id")

  notes        String?
  reportedById String  @map("reported_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  reportedBy User @relation("BreakageAdjustmentReportedBy", fields: [reportedById], references: [id])

  @@index([adjustmentDate])
  @@index([adjustmentType])
  @@map("egg_breakage_adjustments")
}

// ─── Cage Map Models ──────────────────────────────────────────────────────────

model FarmBlock {
  id                  String   @id @default(uuid())
  code                String   @unique
  name                String
  isActive            Boolean  @default(true) @map("is_active")
  isUnderConstruction Boolean  @default(false) @map("is_under_construction")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  farm_sections FarmSection[]

  @@map("farm_blocks")
}

model FarmSection {
  id         String @id @default(uuid())
  blockId    String @map("block_id")
  code       String
  sortOrder  Int    @default(0) @map("sort_order")

  block     FarmBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  farm_rows FarmRow[]

  @@map("farm_sections")
}

model FarmRow {
  id        String  @id @default(uuid())
  sectionId String  @map("section_id")
  rowCode   String  @map("row_code")
  isActive  Boolean @default(true) @map("is_active")

  section     FarmSection          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  assignments BatchCageAssignment?

  @@map("farm_rows")
}

model BatchCageAssignment {
  id           String   @id @default(uuid())
  rowId        String   @unique @map("row_id")
  batchId      String   @map("batch_id")
  birdCount    Int      @default(0) @map("bird_count")
  transferDate DateTime @map("transfer_date") @db.Date
  notes        String?
  assignedById String   @map("assigned_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  row        FarmRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  batch      Batch   @relation(fields: [batchId], references: [id])
  assignedBy User    @relation("CageAssignedBy", fields: [assignedById], references: [id])

  @@map("batch_cage_assignments")
}

// ─── Simple Stock Request ─────────────────────────────────────────────────────

model SimpleStockRequest {
  id            String    @id @default(uuid())
  requestRef    String    @unique @map("request_ref")
  requestDate   DateTime  @map("request_date")
  neededBy      DateTime? @map("needed_by")
  purpose       String?
  notes         String?
  status        String    @default("PENDING") // PENDING | ISSUED | PARTIAL | REJECTED | CANCELLED
  requestedById String    @map("requested_by_id")
  fulfilledById String?   @map("fulfilled_by_id")
  fulfilledAt   DateTime? @map("fulfilled_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  requestedBy User                    @relation("SimpleStockRequestedBy", fields: [requestedById], references: [id])
  fulfilledBy User?                   @relation("SimpleStockFulfilledBy", fields: [fulfilledById], references: [id])
  items       SimpleStockRequestItem[]

  @@index([status])
  @@map("simple_stock_requests")
}

model SimpleStockRequestItem {
  id                String   @id @default(uuid())
  requestId         String   @map("request_id")
  storeItemId       String   @map("store_item_id")
  quantityRequested Decimal  @map("quantity_requested") @db.Decimal(10, 3)
  quantityIssued    Decimal? @map("quantity_issued") @db.Decimal(10, 3)
  stockOutId        String?  @unique @map("stock_out_id")
  notes             String?

  request   SimpleStockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  storeItem StoreItem          @relation(fields: [storeItemId], references: [id])
  stockOut  StoreStockOut?     @relation(fields: [stockOutId], references: [id])

  @@map("simple_stock_request_items")
}

// ─── Egg Breakage Adjustment (Sales) ─────────────────────────────────────────

// ─── Data Upload Log ──────────────────────────────────────────────────────────
// Tracks every spreadsheet import performed by the Director via the data-upload
// feature. The table is best-effort — the service catches errors gracefully —
// but having it in the schema ensures the migration creates the table and
// removes the (prisma as any) cast in DataUploadService.

model DataUploadLog {
  id              String   @id @default(uuid())
  uploadType      String   @map("upload_type")       // "expenses" | "production" | "sales" | "employees"
  fileName        String   @map("file_name")
  recordsImported Int      @default(0) @map("records_imported")
  recordsSkipped  Int      @default(0) @map("records_skipped")
  uploadedById    String   @map("uploaded_by_id")
  uploadedAt      DateTime @default(now()) @map("uploaded_at")

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([uploadType])
  @@index([uploadedAt])
  @@map("data_upload_logs")
}

// ─── Historical Records (Finance Export) ─────────────────────────────────────
// These three models hold pre-migration / legacy data imported by the Director
// via the data-upload feature. The finance export service merges them with live
// Prisma records so exported spreadsheets cover the full date range.

model HistoricalCostRecord {
  id           String   @id @default(uuid())
  date         DateTime @db.Date
  category     String                     // expense category label
  description  String?
  quantity     Decimal? @db.Decimal(10, 3)
  unit         String?
  unitCostKes  Decimal? @map("unit_cost_kes") @db.Decimal(12, 2)
  totalCostKes Decimal  @map("total_cost_kes") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([date])
  @@index([category])
  @@map("historical_cost_records")
}

model HistoricalProductionRecord {
  id         String   @id @default(uuid())
  date       DateTime @db.Date
  batchCode  String?  @map("batch_code")
  birdCount  Int      @map("bird_count")
  mortality  Int?     @default(0)
  goodEggs   Int      @map("good_eggs")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([date])
  @@map("historical_production_records")
}

model HistoricalSalesRecord {
  id            String   @id @default(uuid())
  invoiceDate   DateTime @map("invoice_date") @db.Date
  invoiceNumber String   @map("invoice_number")
  customerName  String   @map("customer_name")
  quantityTrays Int      @map("quantity_trays")
  totalKes      Decimal  @map("total_kes") @db.Decimal(12, 2)
  paymentDate   DateTime? @map("payment_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([invoiceDate])
  @@map("historical_sales_records")
}
