# ─── Database ─────────────────────────────────────────────────────────────────
# Railway PostgreSQL URL (from Railway dashboard after provisioning)
DATABASE_URL=postgresql://postgres:vRAGwFwjKRyCjvOtYkgJaLiGVQwwqUqX@metro.proxy.rlwy.net:46488/railway

# ─── Redis ────────────────────────────────────────────────────────────────────
# Railway Redis URL
REDIS_URL="redis://default:password@host:6379"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME_generate_a_64_byte_random_hex_string"

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS="http://localhost:5173,https://awfms.vercel.app"

# ─── Cloudflare R2 (vet PDF storage) ─────────────────────────────────────────
# From Cloudflare R2 dashboard
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="awfms-vet-reports"
R2_ENDPOINT="https://your_account_id.r2.cloudflarestorage.com"

# ─── Anthropic API (AI reports & alerts) ─────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Email / Notifications (Phase 6) ─────────────────────────────────────────
# Not needed for Phase 1 — in-app notifications only
# RESEND_API_KEY="re_..."
