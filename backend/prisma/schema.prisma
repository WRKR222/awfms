// ─── SALES & DISTRIBUTION ────────────────────────────────────────────────

model Customer {
  id         String    @id @default(uuid())
  name       String
  phone      String?
  email      String?
  address    String?
  isActive   Boolean   @default(true) @map("is_active")
  creditDays Int       @default(0) @map("credit_days")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  salesOrders     SalesOrder[]
  invoices        Invoice[]
  arEntries       ArEntry[]
  advanceBookings AdvanceBooking[]
  deliveryLogs    DeliveryLog[]

  @@map("customers")
}

model EggPriceTier {
  id            String    @id @default(uuid())
  tier          SalesTier
  minTrays      Int       @map("min_trays")
  maxTrays      Int?      @map("max_trays")
  pricePerTray  Decimal   @map("price_per_tray") @db.Decimal(10, 2)
  isActive      Boolean   @default(true) @map("is_active")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("egg_price_tiers")
}

model SalesOrder {
  id              String      @id @default(uuid())
  orderNumber     String      @unique @map("order_number")
  customerId      String      @map("customer_id")
  orderDate       DateTime    @map("order_date") @db.Date
  status          OrderStatus @default(PENDING)
  deliveryDate    DateTime?   @map("delivery_date") @db.Date
  deliveryAddress String?     @map("delivery_address")
  tier            SalesTier
  subtotal        Decimal     @db.Decimal(12, 2)
  notes           String?
  mpesaRef        String?     @map("mpesa_ref")
  bankRef         String?     @map("bank_ref")
  paymentMethod   PaymentMethod @default(CASH) @map("payment_method")
  createdById     String      @map("created_by_id")
  confirmedAt     DateTime?   @map("confirmed_at")
  deliveryNotes   String?     @map("delivery_notes")
  deliveredAt     DateTime?   @map("delivered_at")
  deliveredById   String?     @map("delivered_by_id")
  deletedAt       DateTime?   @map("deleted_at")
  createdAt       DateTime    @default(now()) @map("created_at")
