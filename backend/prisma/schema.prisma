generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ─────────────────────────────────────────────────────────────────

enum UserRole {
  ATTENDANT
  MANAGER
  ACCOUNTANT
  OWNER
  SALES
  STORE
  SECURITY1
  SECURITY2
}

enum BatchStage {
  BROODING
  GROWER
  PRODUCTION
  CLOSED
}

enum BirdType {
  LAYER_COMMERCIAL
  KIENYEJI
}

enum MortalityCause {
  DISEASE
  INJURY
  HEAT_STRESS
  PREDATOR
  CULLED_SICK
  CULLED_LOW_PRODUCTIVITY
  CULLED_OVERPOPULATION
  UNKNOWN
}

enum EntryStatus {
  PENDING
  APPROVED
  RETURNED
}

// EggGrade and SalesTier removed — see migration 20250508_cleanup.

enum FeedType {
  CHICK_MASH
  GROWER_MASH
  LAYER_MASH
  KIENYEJI_STARTER
  KIENYEJI_GROWER
  KIENYEJI_FINISHER
}

enum HealthEventType {
  DISEASE_OUTBREAK
  INJURY
  ROUTINE_CHECKUP
  MEDICATION
  QUARANTINE_IMPOSED
  QUARANTINE_LIFTED
  CULLING
  BIRD_SOLD
  WEIGHING
  VET_VISIT
}

enum VaccinationRoute {
  DRINKING_WATER
  EYE_DROP
  INJECTION
  SPRAY
  WING_WEB
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  RETURNED
  CANCELLED
}

enum PaymentMethod {
  CASH
  MPESA
  BANK
  CREDIT
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum NotificationType {
  FEED_LOW_STOCK
  MORTALITY_ANOMALY
  VERIFICATION_PENDING
  OVERDUE_INVOICE
  VACCINATION_DUE
  AI_REPORT_READY
  ENTRY_RETURNED
  EGG_TALLY_TRIGGERED
  TALLY_SIGNED
  TALLY_LOCKED
  TALLY_EDITED
  STOCK_LOCKED_BOOKING
  BOOKING_CANCELLED
  SYSTEM
  PURCHASE_REQUEST
  STOCK_REQUEST
  STOCK_REQUEST_FULFILLED
  LPO_SUBMITTED
  LPO_APPROVED
}

enum StoreItemCategory {
  MEDICATION
  EQUIPMENT
  FEED_SUPPLEMENT
  PACKAGING
  CLEANING
  SAFETY
  OTHER
}

enum StoreItemUnit {
  KG
  G
  L
  ML
  PIECE
  BOX
  BAG
  BOTTLE
  SACHET
  TRAY
}

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  LPO_RAISED
  REJECTED
}

enum LPOStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CANCELLED
}

enum SimpleStockRequestStatus {
  PENDING
  ISSUED
  PARTIAL
  REJECTED
  CANCELLED
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum ConstructionType {
  NEW_STRUCTURE
  RENOVATION
  REPAIR
  MAINTENANCE
  EXPANSION
}

// ─── AUTHENTICATION & RBAC ─────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole
  fullName     String    @map("full_name")
  houseIds     String[]  @map("house_ids")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  refreshTokens             RefreshToken[]
  auditLogs                 AuditLog[]
  feedIntakeLogs            FeedIntakeLog[]
  notifications             Notification[]
  createdBatches            Batch[]                  @relation("BatchCreatedBy")
  passwordResetsReceived    PasswordResetLog[]       @relation("PasswordResetTarget")
  passwordResetsPerformed   PasswordResetLog[]       @relation("PasswordResetAdmin")
  deliveryLogsLogged        DeliveryLog[]            @relation("DeliveryLogsLogged")
  dailyPricesSet            DailyEggPrice[]
  brooderLogs               BrooderLog[]             @relation("BrooderLoggedBy")

  // Phase 4
  storeMedicationLogs       StoreMedicationLog[]     @relation("StoreMedicationLoggedBy")
  storeEquipmentLogs        StoreEquipmentLog[]      @relation("StoreEquipmentLoggedBy")
  storeWorkerAssignments    StoreWorkerAssignment[]  @relation("StoreWorkerAssignmentLoggedBy")
  expenseCategories         ExpenseCategory[]        @relation("ExpenseCategoryCreatedBy")
  eggPriceSchedules         EggPriceSchedule[]       @relation("EggPriceScheduleSetBy")

  // Phase 2 store
  storeStockIns             StoreStockIn[]           @relation("StoreStockInReceivedBy")
  storeStockOuts            StoreStockOut[]          @relation("StoreStockOutIssuedBy")
  purchaseRequests          PurchaseRequest[]        @relation("PurchaseRequestCreatedBy")
  purchaseRequestReviews    PurchaseRequest[]        @relation("PurchaseRequestReviewedBy")
  lposCreated               LocalPurchaseOrder[]     @relation("LPOCreatedBy")
  lposApproved              LocalPurchaseOrder[]     @relation("LPOApprovedBy")

  // New: simple stock requests
  simpleStockRequests       SimpleStockRequest[]     @relation("SimpleStockRequestCreatedBy")
  simpleStockRequestsFilled SimpleStockRequest[]     @relation("SimpleStockRequestFulfilledBy")

  // New: tally signatures (3-party)
  tallyPmSigned             EggTallyVerification[]   @relation("TallyPmSignedBy")
  tallySalesSigned          EggTallyVerification[]   @relation("TallySalesSignedBy")
  tallyStoreSigned          EggTallyVerification[]   @relation("TallyStoreSignedBy")
  tallyEdited               EggTallyVerification[]   @relation("TallyLastEditedBy")
  tallyRevenueSet           EggTallyVerification[]   @relation("TallyRevenueSetBy")
  sessionsEdited            EggCollectionSession[]   @relation("EggCollectionSessionEditedBy")
  sessionsCollected         EggCollectionSession[]   @relation("EggCollectionSessionCollectedBy")

  // New: vet PDF on HealthEvent
  vetPdfUploads             HealthEvent[]            @relation("HealthEventVetPdfUploader")

  // New: visitor advance notice
  visitorNoticesRequested   VisitorAdvanceNotice[]   @relation("VisitorNoticeRequestedBy")
  visitorNoticesApproved    VisitorAdvanceNotice[]   @relation("VisitorNoticeApprovedBy")
  visitorLogs               VisitorLog[]             @relation("VisitorLogRecordedBy")

  // New: cage map deactivation audit
  cageDeactivations         BatchCageAssignment[]    @relation("CageAssignmentDeactivatedBy")
  cageAssignments           BatchCageAssignment[]    @relation("CageAssignmentAssignedBy")

  // New: construction labor
  constructionLaborLogs     ConstructionLaborRecord[] @relation("ConstructionLaborLoggedBy")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─── FARM INFRASTRUCTURE ────────────────────────────────────────────────────

model House {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  capacity    Int
  birdType    BirdType @map("bird_type")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  batches           Batch[]
  workerAssignments StoreWorkerAssignment[]

  @@map("houses")
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  contact   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  batches Batch[]
  lpos    LocalPurchaseOrder[]

  @@map("suppliers")
}

model Batch {
  id                   String     @id @default(uuid())
  batchCode            String     @unique @map("batch_code")
  supplierId           String     @map("supplier_id")
  houseId              String     @map("house_id")
  birdType             BirdType   @map("bird_type")
  strain               String
  quantityReceived     Int        @map("quantity_received")
  currentBirdCount     Int        @map("current_bird_count")
  dateOfHatch          DateTime   @map("date_of_hatch")
  dateReceived         DateTime   @map("date_received")
  stage                BatchStage @default(BROODING)
  location             String     @default("PRODUCTION_HOUSE") @map("location")
  vaccinationOnArrival Boolean    @default(false) @map("vaccination_on_arrival")
  mortalityOnArrival   Int        @default(0) @map("mortality_on_arrival")
  transportConditions  String?    @map("transport_conditions")
  notes                String?
  isActive             Boolean    @default(true) @map("is_active")
  closedAt             DateTime?  @map("closed_at")
  createdById          String     @map("created_by_id")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")
  deletedAt            DateTime?  @map("deleted_at")

  supplier              Supplier               @relation(fields: [supplierId], references: [id])
  house                 House                  @relation(fields: [houseId], references: [id])
  createdBy             User                   @relation("BatchCreatedBy", fields: [createdById], references: [id])
  feedIntakeLogs        FeedIntakeLog[]
  brooderLogs           BrooderLog[]
  weightSamples         BirdWeightSample[]
  vaccinationRecords    VaccinationRecord[]
  healthEvents          HealthEvent[]
  eggCollectionSessions EggCollectionSession[]
  storeMedicationLogs   StoreMedicationLog[]

  @@index([houseId])
  @@index([stage])
  @@index([isActive])
  @@map("batches")
}

// FlockDailyEntry — REMOVED (replaced by EggCollectionSession). See migration 20250508_cleanup.

model BirdWeightSample {
  id             String   @id @default(uuid())
  batchId        String   @map("batch_id")
  sampleDate     DateTime @map("sample_date") @db.Date
  sampleCount    Int      @map("sample_count")
  totalWeightG   Int      @map("total_weight_g")
  averageWeightG Decimal  @map("average_weight_g") @db.Decimal(8, 2)
  ageWeeks       Int      @map("age_weeks")
  notes          String?
  recordedById   String   @map("recorded_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  batch Batch @relation(fields: [batchId], references: [id])

  @@index([batchId, sampleDate])
  @@map("bird_weight_samples")
}

// ─── FEED MANAGEMENT ─────────────────────────────────────────────────────────

model FeedDelivery {
  id            String   @id @default(uuid())
  feedType      FeedType @map("feed_type")
  supplierName  String   @map("supplier_name")
  quantityKg    Decimal  @map("quantity_kg") @db.Decimal(10, 2)
  pricePerKg    Decimal  @map("price_per_kg") @db.Decimal(10, 2)
  totalCost     Decimal  @map("total_cost") @db.Decimal(12, 2)
  deliveryDate  DateTime @map("delivery_date") @db.Date
  invoiceNumber String?  @map("invoice_number")
  notes         String?
  recordedById  String   @map("recorded_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([feedType, deliveryDate])
  @@map("feed_deliveries")
}

model FeedIntakeLog {
  id                  String      @id @default(uuid())
  batchId             String      @map("batch_id")
  houseId             String      @map("house_id")
  feedType            FeedType    @map("feed_type")
  entryDate           DateTime    @map("entry_date") @db.Date
  quantityDispensedKg Decimal     @map("quantity_dispensed_kg") @db.Decimal(8, 2)
  wastageKg           Decimal     @default(0) @map("wastage_kg") @db.Decimal(8, 2)
  recommendedMinKg    Decimal?    @map("recommended_min_kg") @db.Decimal(8, 2)
  recommendedMaxKg    Decimal?    @map("recommended_max_kg") @db.Decimal(8, 2)
  status              EntryStatus @default(PENDING)
  notes               String?
  recordedById        String      @map("recorded_by_id")
  approvedById        String?     @map("approved_by_id")
  approvedAt          DateTime?   @map("approved_at")
  returnReason        String?     @map("return_reason")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  batch      Batch @relation(fields: [batchId], references: [id])
  recordedBy User  @relation(fields: [recordedById], references: [id])

  @@unique([batchId, entryDate, feedType])
  @@index([batchId, entryDate])
  @@index([status])
  @@map("feed_intake_logs")
}

model FeedStockSnapshot {
  id              String   @id @default(uuid())
  feedType        FeedType @map("feed_type")
  snapshotDate    DateTime @map("snapshot_date") @db.Date
  stockKg         Decimal  @map("stock_kg") @db.Decimal(10, 2)
  avgDailyUsageKg Decimal  @map("avg_daily_usage_kg") @db.Decimal(8, 2)
  daysRemaining   Decimal  @map("days_remaining") @db.Decimal(6, 1)
  alertFired      Boolean  @default(false) @map("alert_fired")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([feedType, snapshotDate])
  @@map("feed_stock_snapshots")
}

// ─── HEALTH & BIOSECURITY ─────────────────────────────────────────────────

model VaccinationSchedule {
  id           String           @id @default(uuid())
  vaccineName  String           @map("vaccine_name")
  birdType     BirdType         @map("bird_type")
  ageWeeks     Int              @map("age_weeks")
  route        VaccinationRoute
  boosterWeeks Int?             @map("booster_weeks")
  isActive     Boolean          @default(true) @map("is_active")
  notes        String?
  createdAt    DateTime         @default(now()) @map("created_at")

  records VaccinationRecord[]

  @@map("vaccination_schedule")
}

model VaccinationRecord {
  id               String           @id @default(uuid())
  batchId          String           @map("batch_id")
  scheduleId       String?          @map("schedule_id")
  vaccineName      String           @map("vaccine_name")
  administeredDate DateTime         @map("administered_date") @db.Date
  route            VaccinationRoute
  batchSize        Int              @map("batch_size")
  dosageUnits      String?          @map("dosage_units")
  vetName          String?          @map("vet_name")
  notes            String?
  recordedById     String           @map("recorded_by_id")
  createdAt        DateTime         @default(now()) @map("created_at")

  batch    Batch                @relation(fields: [batchId], references: [id])
  schedule VaccinationSchedule? @relation(fields: [scheduleId], references: [id])

  @@index([batchId])
  @@map("vaccination_records")
}

model HealthEvent {
  id            String          @id @default(uuid())
  batchId       String          @map("batch_id")
  eventType     HealthEventType @map("event_type")
  eventDate     DateTime        @map("event_date") @db.Date
  affectedCount Int             @map("affected_count")
  symptoms      String?
  diagnosis     String?
  treatment     String?
  outcome       String?
  isResolved    Boolean         @default(false) @map("is_resolved")
  resolvedAt    DateTime?       @map("resolved_at")
  recordedById  String          @map("recorded_by_id")

  // Vet PDF (Manager-only upload — replaces standalone StoreVetVisitLog)
  vetPdfUrl            String?   @map("vet_pdf_url")
  vetPdfUploadedById   String?   @map("vet_pdf_uploaded_by_id")
  vetPdfUploadedAt     DateTime? @map("vet_pdf_uploaded_at")

  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  batch            Batch          @relation(fields: [batchId], references: [id])
  vetPdfUploadedBy User?          @relation("HealthEventVetPdfUploader", fields: [vetPdfUploadedById], references: [id])
  vetReports       VetPdfReport[] // legacy table kept for historical records

  @@index([batchId, eventDate])
  @@map("health_events")
}

// Legacy — kept for historical reads only. New uploads go on HealthEvent.
model VetPdfReport {
  id            String   @id @default(uuid())
  batchId       String   @map("batch_id")
  healthEventId String?  @map("health_event_id")
  reportDate    DateTime @map("report_date") @db.Date
  vetName       String   @map("vet_name")
  summary       String
  r2Key         String   @map("r2_key")
  r2Url         String   @map("r2_url")
  fileSizeBytes Int      @map("file_size_bytes")
  uploadedById  String   @map("uploaded_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  healthEvent HealthEvent? @relation(fields: [healthEventId], references: [id])

  @@index([batchId])
  @@map("vet_pdf_reports")
}

model VisitorLog {
  id                String    @id @default(uuid())
  visitorName       String    @map("visitor_name")
  organisation      String?
  purpose           String
  checkInAt         DateTime  @map("check_in_at")
  checkOutAt        DateTime? @map("check_out_at")
  biosecurityChecks Json      @map("biosecurity_checks")
  houseId           String?   @map("house_id")
  recordedById      String    @map("recorded_by_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  recordedBy        User      @relation("VisitorLogRecordedBy", fields: [recordedById], references: [id])

  @@index([checkInAt])
  @@map("visitor_log")
}

// ─── PHASE 3: EGG COLLECTION SESSION ────────────────────────────────────────
// CLEANED UP: removed duplicate verifiedById/storeSignedById columns. The 3-party
// tally is authoritative on EggTallyVerification only.

model EggCollectionSession {
  id            String      @id @default(uuid())
  batchId       String      @map("batch_id")
  houseId       String      @map("house_id")
  sessionDate   DateTime    @map("session_date") @db.Date
  shift         String
  collectedById String      @map("collected_by_id")

  openingPop    Int         @map("opening_pop")
  mortalities   Int         @default(0)
  closingStock  Int         @map("closing_stock")
  rowData       Json        @map("row_data")

  totalFullTrays  Int       @map("total_full_trays")
  totalLooseEggs  Int       @map("total_loose_eggs")
  totalBrokenEggs Int       @default(0) @map("total_broken_eggs")
  totalSoftShell  Int       @default(0) @map("total_soft_shell")
  totalDeformed   Int       @default(0) @map("total_deformed")
  totalWeightKg   Decimal   @map("total_weight_kg") @db.Decimal(8, 2)
  totalGoodEggs   Int       @map("total_good_eggs")
  henDayPercent   Decimal?  @map("hen_day_percent") @db.Decimal(5, 2)

  vaccineGiven  String?     @map("vaccine_given")
  dailyFeedKg   Decimal?    @map("daily_feed_kg") @db.Decimal(8, 2)
  remarks       String?

  // Lifecycle: PENDING → APPROVED (by Manager same evening for PM session) → locked
  // by tally verification 3-party signing the next morning. RETURNED if Manager rejects.
  status         EntryStatus @default(PENDING)
  returnReason   String?     @map("return_reason")

  // Edit audit (only Manager may edit during the morning tally — see TallyVerificationService)
  editedAt       DateTime?   @map("edited_at")
  editedById     String?     @map("edited_by_id")

  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  deletedAt      DateTime?   @map("deleted_at")

  batch        Batch                  @relation(fields: [batchId], references: [id])
  collectedBy  User                   @relation("EggCollectionSessionCollectedBy", fields: [collectedById], references: [id])
  editedBy     User?                  @relation("EggCollectionSessionEditedBy", fields: [editedById], references: [id])
  storeIntakes StoreEggIntake[]
  tally        EggTallyVerification?

  @@unique([batchId, houseId, sessionDate, shift])
  @@index([houseId, sessionDate])
  @@index([status])
  @@index([deletedAt])
  @@map("egg_collection_sessions")
}

// ─── PHASE 3: STORE EGG INTAKE ───────────────────────────────────────────────

model StoreEggIntake {
  id             String   @id @default(uuid())
  sessionId      String   @unique @map("session_id")
  houseId        String   @map("house_id")
  intakeDate     DateTime @map("intake_date") @db.Date
  shift          String
  receivedById   String   @map("received_by_id")

  rowData        Json     @map("row_data")

  totalFullTrays Int      @map("total_full_trays")
  totalLooseEggs Int      @map("total_loose_eggs")
  totalGoodEggs  Int      @map("total_good_eggs")
  totalWeightKg  Decimal  @map("total_weight_kg") @db.Decimal(8, 2)

  hasDiscrepancy  Boolean @default(false) @map("has_discrepancy")
  discrepancyNote String? @map("discrepancy_note")

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  session EggCollectionSession @relation(fields: [sessionId], references: [id])

  @@index([houseId, intakeDate])
  @@map("store_egg_intakes")
}

// ─── PHASE 3: DAILY EGG PRICE ────────────────────────────────────────────────

model DailyEggPrice {
  id                  String   @id @default(uuid())
  priceDate           DateTime @unique @map("price_date") @db.Date
  pricePerEgg         Decimal  @map("price_per_egg") @db.Decimal(8, 4)
  pricePerEggStarter  Decimal? @map("price_per_egg_starter") @db.Decimal(8, 4)
  pricePerEggBroken   Decimal? @map("price_per_egg_broken") @db.Decimal(8, 4)
  expectedRevenue     Decimal? @map("expected_revenue") @db.Decimal(12, 2)
  notes               String?
  setById             String   @map("set_by_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  setBy User @relation(fields: [setById], references: [id])

  @@index([priceDate])
  @@map("daily_egg_prices")
}

// ─── EGG TALLY VERIFICATION (3-party morning sign-off) ────────────────────
// Authoritative tally record. PM/Sales/Store each sign; Manager may edit (which
// clears all signatures and bumps editCount); when all three signatures present,
// service flips isLocked=true and freezes finals + revenue.

model EggTallyVerification {
  id               String    @id @default(uuid())
  sessionId        String    @unique @map("session_id")
  verificationDate DateTime  @map("verification_date") @db.Date

  pmSignedById     String?   @map("pm_signed_by_id")
  pmSignedAt       DateTime? @map("pm_signed_at")
  pmRowData        Json?     @map("pm_row_data")

  salesSignedById  String?   @map("sales_signed_by_id")
  salesSignedAt    DateTime? @map("sales_signed_at")
  salesRowData     Json?     @map("sales_row_data")

  storeSignedById  String?   @map("store_signed_by_id")
  storeSignedAt    DateTime? @map("store_signed_at")
  storeRowData     Json?     @map("store_row_data")

  isLocked       Boolean   @default(false) @map("is_locked")
  lockedAt       DateTime? @map("locked_at")
  finalGoodEggs  Int?      @map("final_good_eggs")
  finalFullTrays Int?      @map("final_full_trays")
  finalLooseEggs Int?      @map("final_loose_eggs")

  expectedRevenueKes Decimal?  @map("expected_revenue_kes") @db.Decimal(12, 2)
  revenueSetById     String?   @map("revenue_set_by_id")
  revenueSetAt       DateTime? @map("revenue_set_at")

  // Edit audit
  editCount        Int       @default(0) @map("edit_count")
  lastEditedById   String?   @map("last_edited_by_id")
  lastEditedAt     DateTime? @map("last_edited_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  session       EggCollectionSession @relation(fields: [sessionId], references: [id])
  pmSignedBy    User? @relation("TallyPmSignedBy",    fields: [pmSignedById],    references: [id])
  salesSignedBy User? @relation("TallySalesSignedBy", fields: [salesSignedById], references: [id])
  storeSignedBy User? @relation("TallyStoreSignedBy", fields: [storeSignedById], references: [id])
  lastEditedBy  User? @relation("TallyLastEditedBy",  fields: [lastEditedById],  references: [id])
