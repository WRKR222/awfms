  return_reason    String?
  created_at       DateTime    @default(now())
  updated_at       DateTime
  batches          Batch       @relation(fields: [batch_id], references: [id])
  users            User        @relation(fields: [submitted_by_id], references: [id])

  @@unique([batch_id, entry_date, shift])
