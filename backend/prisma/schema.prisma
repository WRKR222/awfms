  totalBrokenUnsellable Int      @default(0) @map("total_broken_unsellable")
  expectedRevenueKes    Decimal? @map("expected_revenue_kes") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  batch Batch @relation(fields: [batchId], references: [id])

  @@unique([aggregateDate, batchId, houseId])
  @@index([aggregateDate])
  @@index([batchId])
  @@map("daily_egg_aggregates")
}

