generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ─────────────────────────────────────────────────────────────────

enum UserRole {
  ATTENDANT
  SUPERVISOR
  MANAGER
  ACCOUNTANT
  OWNER
}

enum BatchStage {
  BROODING    // 0-6 weeks
  GROWER      // 6-18 weeks
  PRODUCTION  // 18+ weeks
  CLOSED
}

enum BirdType {
  LAYER_COMMERCIAL
  KIENYEJI
}

enum MortalityCause {
  DISEASE
  INJURY
  HEAT_STRESS
  PREDATOR
  CULLED_SICK
  CULLED_LOW_PRODUCTIVITY
  CULLED_OVERPOPULATION
  UNKNOWN
}

enum EntryStatus {
  PENDING
  APPROVED
  RETURNED
}

enum EggGrade {
  SMALL
  MEDIUM
  LARGE
  EXTRA_LARGE
  REJECT
}

enum FeedType {
  CHICK_MASH
  GROWER_MASH
  LAYER_MASH
  KIENYEJI_STARTER
  KIENYEJI_GROWER
  KIENYEJI_FINISHER
}

enum HealthEventType {
  DISEASE_OUTBREAK
  INJURY
  ROUTINE_CHECKUP
  MEDICATION
  QUARANTINE_IMPOSED
  QUARANTINE_LIFTED
}

enum VaccinationRoute {
  DRINKING_WATER
  EYE_DROP
  INJECTION
  SPRAY
  WING_WEB
}

enum SalesTier {
  TIER_1  // 1-10 trays
  TIER_2  // 11+ trays
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  RETURNED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum NotificationType {
  FEED_LOW_STOCK
  MORTALITY_ANOMALY
  VERIFICATION_PENDING
  OVERDUE_INVOICE
  VACCINATION_DUE
  AI_REPORT_READY
  ENTRY_RETURNED
  SYSTEM
}

// ─── AUTHENTICATION & RBAC ─────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  username      String    @unique
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          UserRole
  fullName      String    @map("full_name")
  houseIds      String[]  @map("house_ids") // assigned houses for attendants
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  flockEntries     FlockDailyEntry[]
  feedIntakeLogs   FeedIntakeLog[]
  productionEntries ProductionEntry[]
  notifications    Notification[]
  createdBatches   Batch[]           @relation("BatchCreatedBy")
  approvedEntries  FlockDailyEntry[] @relation("FlockEntryApprovedBy")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─── FARM INFRASTRUCTURE ────────────────────────────────────────────────────

model House {
  id          String    @id @default(uuid())
  name        String    // e.g. "House 1", "Kienyeji A"
  code        String    @unique // e.g. "H1", "KA"
  capacity    Int
  birdType    BirdType  @map("bird_type")
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  batches Batch[]

  @@map("houses")
}

// ─── FLOCK & BATCH MANAGEMENT ───────────────────────────────────────────────

model Supplier {
  id        String   @id @default(uuid())
  name      String   // e.g. "Kenchic", "Poultry Breeders"
  contact   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  batches Batch[]

  @@map("suppliers")
}

model Batch {
  id                   String     @id @default(uuid())
  batchCode            String     @unique @map("batch_code") // e.g. "LB1-2025"
  supplierId           String     @map("supplier_id")
  houseId              String     @map("house_id")
  birdType             BirdType   @map("bird_type")
  strain               String     // e.g. "Hy-Line Brown", "Kenbro F1"
  quantityReceived     Int        @map("quantity_received")
  currentBirdCount     Int        @map("current_bird_count")
  dateOfHatch          DateTime   @map("date_of_hatch")
  dateReceived         DateTime   @map("date_received")
  stage                BatchStage @default(BROODING)
  vaccinationOnArrival Boolean    @default(false) @map("vaccination_on_arrival")
  mortalityOnArrival   Int        @default(0) @map("mortality_on_arrival")
  transportConditions  String?    @map("transport_conditions")
  notes                String?
  isActive             Boolean    @default(true) @map("is_active")
  closedAt             DateTime?  @map("closed_at")
  createdById          String     @map("created_by_id")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")
  deletedAt            DateTime?  @map("deleted_at")

  supplier          Supplier          @relation(fields: [supplierId], references: [id])
  house             House             @relation(fields: [houseId], references: [id])
  createdBy         User              @relation("BatchCreatedBy", fields: [createdById], references: [id])
  flockEntries      FlockDailyEntry[]
  feedIntakeLogs    FeedIntakeLog[]
  productionEntries ProductionEntry[]
  weightSamples     BirdWeightSample[]
  vaccinationRecords VaccinationRecord[]
  healthEvents      HealthEvent[]

  @@index([houseId])
  @@index([stage])
  @@index([isActive])
  @@map("batches")
}

model FlockDailyEntry {
  id                String      @id @default(uuid())
  batchId           String      @map("batch_id")
  houseId           String      @map("house_id")
  entryDate         DateTime    @map("entry_date") @db.Date
  shift             String      @default("AM") // AM or PM
  openingCount      Int         @map("opening_count")
  mortalityCount    Int         @default(0) @map("mortality_count")
  mortalityCause    MortalityCause? @map("mortality_cause")
  cullingCount      Int         @default(0) @map("culling_count")
  cullingReason     String?     @map("culling_reason")
  closingCount      Int         @map("closing_count") // auto = opening - mortality - culling
  waterConsumptionL Decimal?    @map("water_consumption_l") @db.Decimal(8,2)
  temperatureCelsius Decimal?   @map("temperature_celsius") @db.Decimal(4,1)
  humidityPercent   Decimal?    @map("humidity_percent") @db.Decimal(4,1)
  notes             String?
  status            EntryStatus @default(PENDING)
  submittedById     String      @map("submitted_by_id")
  approvedById      String?     @map("approved_by_id")
  approvedAt        DateTime?   @map("approved_at")
  returnReason      String?     @map("return_reason")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  batch       Batch  @relation(fields: [batchId], references: [id])
  submittedBy User   @relation(fields: [submittedById], references: [id])
  approvedBy  User?  @relation("FlockEntryApprovedBy", fields: [approvedById], references: [id])

  @@unique([batchId, entryDate, shift])
  @@index([batchId, entryDate])
  @@index([status])
  @@index([submittedById])
  @@map("flock_daily_entries")
}

model BirdWeightSample {
  id           String   @id @default(uuid())
  batchId      String   @map("batch_id")
  sampleDate   DateTime @map("sample_date") @db.Date
  sampleCount  Int      @map("sample_count")
  totalWeightG Int      @map("total_weight_g")
  averageWeightG Decimal @map("average_weight_g") @db.Decimal(8,2) // computed
  ageWeeks     Int      @map("age_weeks")
  notes        String?
  recordedById String   @map("recorded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  batch Batch @relation(fields: [batchId], references: [id])

  @@index([batchId, sampleDate])
  @@map("bird_weight_samples")
}

// ─── FEED MANAGEMENT ─────────────────────────────────────────────────────────

model FeedDelivery {
  id              String   @id @default(uuid())
  feedType        FeedType @map("feed_type")
  supplierName    String   @map("supplier_name")
  quantityKg      Decimal  @map("quantity_kg") @db.Decimal(10,2)
  pricePerKg      Decimal  @map("price_per_kg") @db.Decimal(10,2)
  totalCost       Decimal  @map("total_cost") @db.Decimal(12,2)
  deliveryDate    DateTime @map("delivery_date") @db.Date
  invoiceNumber   String?  @map("invoice_number")
  notes           String?
  recordedById    String   @map("recorded_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([feedType, deliveryDate])
  @@map("feed_deliveries")
}

model FeedIntakeLog {
  id              String   @id @default(uuid())
  batchId         String   @map("batch_id")
  houseId         String   @map("house_id")
  feedType        FeedType @map("feed_type")
  entryDate       DateTime @map("entry_date") @db.Date
  quantityDispensedKg Decimal @map("quantity_dispensed_kg") @db.Decimal(8,2)
  wastageKg       Decimal  @default(0) @map("wastage_kg") @db.Decimal(8,2)
  recommendedMinKg Decimal? @map("recommended_min_kg") @db.Decimal(8,2)
  recommendedMaxKg Decimal? @map("recommended_max_kg") @db.Decimal(8,2)
  status          EntryStatus @default(PENDING)
  notes           String?
  recordedById    String   @map("recorded_by_id")
  approvedById    String?  @map("approved_by_id")
  approvedAt      DateTime? @map("approved_at")
  returnReason    String?  @map("return_reason")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  batch Batch @relation(fields: [batchId], references: [id])

  @@unique([batchId, entryDate, feedType])
  @@index([batchId, entryDate])
  @@index([status])
  @@map("feed_intake_logs")
}

model FeedStockSnapshot {
  id             String   @id @default(uuid())
  feedType       FeedType @map("feed_type")
  snapshotDate   DateTime @map("snapshot_date") @db.Date
  stockKg        Decimal  @map("stock_kg") @db.Decimal(10,2)
  avgDailyUsageKg Decimal @map("avg_daily_usage_kg") @db.Decimal(8,2)
  daysRemaining  Decimal  @map("days_remaining") @db.Decimal(6,1)
  alertFired     Boolean  @default(false) @map("alert_fired")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([feedType, snapshotDate])
  @@map("feed_stock_snapshots")
}

// ─── HEALTH & BIOSECURITY ─────────────────────────────────────────────────

model VaccinationSchedule {
  id           String   @id @default(uuid())
  vaccineName  String   @map("vaccine_name")
  birdType     BirdType @map("bird_type")
  ageWeeks     Int      @map("age_weeks")
  route        VaccinationRoute
  boosterWeeks Int?     @map("booster_weeks")
  isActive     Boolean  @default(true) @map("is_active")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  records VaccinationRecord[]

  @@map("vaccination_schedule")
}

model VaccinationRecord {
  id              String   @id @default(uuid())
  batchId         String   @map("batch_id")
  scheduleId      String?  @map("schedule_id")
  vaccineName     String   @map("vaccine_name")
  administeredDate DateTime @map("administered_date") @db.Date
  route           VaccinationRoute
  batchSize       Int      @map("batch_size") // number of birds vaccinated
  dosageUnits     String?  @map("dosage_units")
  vetName         String?  @map("vet_name")
  notes           String?
  recordedById    String   @map("recorded_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  batch    Batch               @relation(fields: [batchId], references: [id])
  schedule VaccinationSchedule? @relation(fields: [scheduleId], references: [id])

  @@index([batchId])
  @@map("vaccination_records")
}

model HealthEvent {
  id           String          @id @default(uuid())
  batchId      String          @map("batch_id")
  eventType    HealthEventType @map("event_type")
  eventDate    DateTime        @map("event_date") @db.Date
  affectedCount Int            @map("affected_count")
  symptoms     String?
  diagnosis    String?
  treatment    String?
  outcome      String?
  isResolved   Boolean         @default(false) @map("is_resolved")
  resolvedAt   DateTime?       @map("resolved_at")
  recordedById String          @map("recorded_by_id")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  batch       Batch       @relation(fields: [batchId], references: [id])
  vetReports  VetPdfReport[]

  @@index([batchId, eventDate])
  @@map("health_events")
}

model VetPdfReport {
  id              String   @id @default(uuid())
  batchId         String   @map("batch_id")
  healthEventId   String?  @map("health_event_id")
  reportDate      DateTime @map("report_date") @db.Date
  vetName         String   @map("vet_name")
  summary         String   // plain English summary added on upload
  r2Key           String   @map("r2_key") // Cloudflare R2 object key
  r2Url           String   @map("r2_url") // signed URL (refreshed on access)
  fileSizeBytes   Int      @map("file_size_bytes")
  uploadedById    String   @map("uploaded_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  healthEvent HealthEvent? @relation(fields: [healthEventId], references: [id])

  @@index([batchId])
  @@map("vet_pdf_reports")
}

model VisitorLog {
  id               String   @id @default(uuid())
  visitorName      String   @map("visitor_name")
  organisation     String?
  purpose          String
  checkInAt        DateTime @map("check_in_at")
  checkOutAt       DateTime? @map("check_out_at")
  biosecurityChecks Json    @map("biosecurity_checks") // checklist JSON
  houseId          String?  @map("house_id")
  recordedById     String   @map("recorded_by_id")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([checkInAt])
  @@map("visitor_log")
}

// ─── PRODUCTION TRACKING ──────────────────────────────────────────────────

model ProductionEntry {
  id              String      @id @default(uuid())
  batchId         String      @map("batch_id")
  houseId         String      @map("house_id")
  entryDate       DateTime    @map("entry_date") @db.Date
  shift           String      @default("AM")
  eggsSmall       Int         @default(0) @map("eggs_small")
  eggsMedium      Int         @default(0) @map("eggs_medium")
  eggsLarge       Int         @default(0) @map("eggs_large")
  eggsExtraLarge  Int         @default(0) @map("eggs_extra_large")
  eggsReject      Int         @default(0) @map("eggs_reject")
  totalEggs       Int         @map("total_eggs") // auto-computed
  henDayPercent   Decimal?    @map("hen_day_percent") @db.Decimal(5,2) // auto-computed
  status          EntryStatus @default(PENDING)
  notes           String?
  submittedById   String      @map("submitted_by_id")
  approvedById    String?     @map("approved_by_id")
  approvedAt      DateTime?   @map("approved_at")
  returnReason    String?     @map("return_reason")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  batch       Batch @relation(fields: [batchId], references: [id])
  submittedBy User  @relation(fields: [submittedById], references: [id])

  @@unique([batchId, entryDate, shift])
  @@index([batchId, entryDate])
  @@index([status])
  @@map("production_entries")
}

// ─── INVENTORY ───────────────────────────────────────────────────────────

model InventoryMovement {
  id           String   @id @default(uuid())
  itemType     String   @map("item_type") // EGGS, MEAT, PACKAGING
  grade        String?  // egg grade or meat cut
  movementType String   @map("movement_type") // IN, OUT, ADJUSTMENT, SPOILAGE
  quantity     Int
  referenceId  String?  @map("reference_id") // production entry ID, order ID, etc.
  notes        String?
  recordedById String   @map("recorded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([itemType, movementType])
  @@index([createdAt])
  @@map("inventory_movements")
}

model TemperatureLog {
  id            String   @id @default(uuid())
  locationId    String   @map("location_id") // house ID or cold room ID
  locationType  String   @map("location_type") // HOUSE, COLD_ROOM
  temperatureC  Decimal  @map("temperature_c") @db.Decimal(4,1)
  humidityPct   Decimal? @map("humidity_pct") @db.Decimal(4,1)
  loggedAt      DateTime @map("logged_at")
  recordedById  String   @map("recorded_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([locationId, loggedAt])
  @@map("temperature_logs")
}

// ─── SALES & DISTRIBUTION ────────────────────────────────────────────────

model Customer {
  id          String   @id @default(uuid())
  name        String
  phone       String?
  email       String?
  address     String?
  isActive    Boolean  @default(true) @map("is_active")
  creditDays  Int      @default(0) @map("credit_days") // payment terms
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  salesOrders SalesOrder[]
  invoices    Invoice[]
  arEntries   ArEntry[]

  @@map("customers")
}

model EggPriceTier {
  id          String   @id @default(uuid())
  tier        SalesTier
  minTrays    Int      @map("min_trays")
  maxTrays    Int?     @map("max_trays")
  pricePerTray Decimal @map("price_per_tray") @db.Decimal(10,2)
  isActive    Boolean  @default(true) @map("is_active")
  effectiveFrom DateTime @map("effective_from") @db.Date
  effectiveTo DateTime? @map("effective_to") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("egg_price_tiers")
}

model SalesOrder {
  id              String      @id @default(uuid())
  orderNumber     String      @unique @map("order_number")
  customerId      String      @map("customer_id")
  orderDate       DateTime    @map("order_date") @db.Date
  status          OrderStatus @default(PENDING)
  deliveryDate    DateTime?   @map("delivery_date") @db.Date
  deliveryAddress String?     @map("delivery_address")
  tier            SalesTier
  subtotal        Decimal     @db.Decimal(12,2)
  notes           String?
  createdById     String      @map("created_by_id")
  confirmedAt     DateTime?   @map("confirmed_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  customer     Customer          @relation(fields: [customerId], references: [id])
  items        SalesOrderItem[]
  invoices     Invoice[]

  @@index([customerId])
  @@index([status])
  @@index([orderDate])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String    @id @default(uuid())
  orderId      String    @map("order_id")
  itemType     String    @map("item_type") // EGGS, MEAT
  grade        String?   // egg grade
  quantityTrays Int?     @map("quantity_trays")
  quantityKg    Decimal? @map("quantity_kg") @db.Decimal(8,2)
  unitPrice    Decimal   @map("unit_price") @db.Decimal(10,2)
  subtotal     Decimal   @db.Decimal(12,2)

  order SalesOrder @relation(fields: [orderId], references: [id])

  @@map("sales_order_items")
}

// ─── INVOICES & AR ────────────────────────────────────────────────────────

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique @map("invoice_number")
  salesOrderId    String?       @map("sales_order_id")
  customerId      String        @map("customer_id")
  invoiceDate     DateTime      @map("invoice_date") @db.Date
  dueDate         DateTime      @map("due_date") @db.Date
  subtotal        Decimal       @db.Decimal(12,2)
  taxAmount       Decimal       @default(0) @map("tax_amount") @db.Decimal(12,2)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(12,2)
  paidAmount      Decimal       @default(0) @map("paid_amount") @db.Decimal(12,2)
  balanceDue      Decimal       @map("balance_due") @db.Decimal(12,2)
  status          InvoiceStatus @default(UNPAID)
  pdfR2Key        String?       @map("pdf_r2_key")
  notes           String?
  createdById     String        @map("created_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  salesOrder SalesOrder?      @relation(fields: [salesOrderId], references: [id])
  customer   Customer         @relation(fields: [customerId], references: [id])
  payments   InvoicePayment[]
  arEntry    ArEntry?

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model InvoicePayment {
  id            String   @id @default(uuid())
  invoiceId     String   @map("invoice_id")
  paymentDate   DateTime @map("payment_date") @db.Date
  amount        Decimal  @db.Decimal(12,2)
  paymentMethod String   @map("payment_method") // MPESA, BANK_TRANSFER, CASH, CHEQUE
  reference     String?  // M-Pesa code, cheque number, etc.
  notes         String?
  recordedById  String   @map("recorded_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("invoice_payments")
}

model ArEntry {
  id             String   @id @default(uuid())
  invoiceId      String   @unique @map("invoice_id")
  customerId     String   @map("customer_id")
  originalAmount Decimal  @map("original_amount") @db.Decimal(12,2)
  currentBalance Decimal  @map("current_balance") @db.Decimal(12,2)
  dueDate        DateTime @map("due_date") @db.Date
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  invoice  Invoice  @relation(fields: [invoiceId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([dueDate])
  @@map("ar_entries")
}

// ─── FINANCE ─────────────────────────────────────────────────────────────

model ExpenseLog {
  id          String   @id @default(uuid())
  category    String   // QuickBooks-aligned: FEED_COST, MEDICATION, LABOUR, etc.
  description String
  amount      Decimal  @db.Decimal(12,2)
  expenseDate DateTime @map("expense_date") @db.Date
  batchId     String?  @map("batch_id")
  vendorName  String?  @map("vendor_name")
  receiptRef  String?  @map("receipt_ref")
  recordedById String  @map("recorded_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([category, expenseDate])
  @@index([batchId])
  @@map("expense_logs")
}

// ─── AI & NOTIFICATIONS ──────────────────────────────────────────────────

model AiReport {
  id          String   @id @default(uuid())
  reportType  String   @map("report_type") // WEEKLY_PERFORMANCE, FEED_ALERT, etc.
  weekEnding  DateTime? @map("week_ending") @db.Date
  content     String   // full AI-generated plain English report
  rawData     Json     @map("raw_data") // the data used to generate the report
  generatedAt DateTime @default(now()) @map("generated_at")

  @@index([reportType, weekEnding])
  @@map("ai_reports")
}

model Notification {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  type       NotificationType
  title      String
  message    String
  entityId   String?          @map("entity_id")
  entityType String?          @map("entity_type")
  isRead     Boolean          @default(false) @map("is_read")
  readAt     DateTime?        @map("read_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}
