generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                                                      String                     @id @default(uuid())
  username                                                                String                     @unique
  email                                                                   String                     @unique
  passwordHash                                                            String                     @map("password_hash")
  role                                                                    UserRole
  fullName                                                                String                     @map("full_name")
  houseIds                                                                String[]                   @map("house_ids")
  isActive                                                                Boolean                    @default(true) @map("is_active")
  lastLoginAt                                                             DateTime?                  @map("last_login_at")
  createdAt                                                               DateTime                   @default(now()) @map("created_at")
  updatedAt                                                               DateTime                   @updatedAt @map("updated_at")
  deletedAt                                                               DateTime?                  @map("deleted_at")
  auditLogs                                                               AuditLog[]
  createdBatches                                                          Batch[]                    @relation("BatchCreatedBy")
  brooderLogs                                                             BrooderLog[]               @relation("BrooderLoggedBy")
  dailyPricesSet                                                          DailyEggPrice[]
  deliveryLogsLogged                                                      DeliveryLog[]              @relation("DeliveryLogsLogged")
  egg_breakage_adjustments_egg_breakage_adjustments_reported_by_idTousers egg_breakage_adjustments[] @relation("egg_breakage_adjustments_reported_by_idTousers")
  egg_breakage_adjustments_egg_breakage_adjustments_reviewed_by_idTousers egg_breakage_adjustments[] @relation("egg_breakage_adjustments_reviewed_by_idTousers")
  eggPriceSchedules                                                       EggPriceSchedule[]         @relation("EggPriceScheduleSetBy")
  expenseCategories                                                       ExpenseCategory[]          @relation("ExpenseCategoryCreatedBy")
  feed_intake_logs                                                        FeedIntakeLog[]
  flock_daily_entries_flock_daily_entries_approved_by_idTousers           flock_daily_entries[]      @relation("flock_daily_entries_approved_by_idTousers")
  flock_daily_entries_flock_daily_entries_submitted_by_idTousers          flock_daily_entries[]      @relation("flock_daily_entries_submitted_by_idTousers")
  notifications                                                           Notification[]
  passwordResetsPerformed                                                 PasswordResetLog[]         @relation("PasswordResetAdmin")
  passwordResetsReceived                                                  PasswordResetLog[]         @relation("PasswordResetTarget")
  production_entries                                                      production_entries[]
  refreshTokens                                                           RefreshToken[]
  storeEquipmentLogs                                                      StoreEquipmentLog[]        @relation("StoreEquipmentLoggedBy")
  storeMedicationLogs                                                     StoreMedicationLog[]       @relation("StoreMedicationLoggedBy")
  store_vet_visit_logs                                                    store_vet_visit_logs[]
  storeWorkerAssignments                                                  StoreWorkerAssignment[]    @relation("StoreWorkerAssignmentLoggedBy")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model House {
  id                String                  @id @default(uuid())
  name              String
  code              String                  @unique
  capacity          Int
  birdType          BirdType                @map("bird_type")
  description       String?
  isActive          Boolean                 @default(true) @map("is_active")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  batches           Batch[]
  workerAssignments StoreWorkerAssignment[]

  @@map("houses")
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  contact   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  batches   Batch[]

  @@map("suppliers")
}

model Batch {
  id                    String                 @id @default(uuid())
  batchCode             String                 @unique @map("batch_code")
  supplierId            String                 @map("supplier_id")
  houseId               String                 @map("house_id")
  birdType              BirdType               @map("bird_type")
  strain                String
  quantityReceived      Int                    @map("quantity_received")
  currentBirdCount      Int                    @map("current_bird_count")
  dateOfHatch           DateTime               @map("date_of_hatch")
  dateReceived          DateTime               @map("date_received")
  stage                 BatchStage             @default(BROODING)
  vaccinationOnArrival  Boolean                @default(false) @map("vaccination_on_arrival")
  mortalityOnArrival    Int                    @default(0) @map("mortality_on_arrival")
  transportConditions   String?                @map("transport_conditions")
  notes                 String?
  isActive              Boolean                @default(true) @map("is_active")
  closedAt              DateTime?              @map("closed_at")
  createdById           String                 @map("created_by_id")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  deletedAt             DateTime?              @map("deleted_at")
  location              String                 @default("PRODUCTION_HOUSE") @map("location")
  createdBy             User                   @relation("BatchCreatedBy", fields: [createdById], references: [id])
  house                 House                  @relation(fields: [houseId], references: [id])
  supplier              Supplier               @relation(fields: [supplierId], references: [id])
  weightSamples         BirdWeightSample[]
  brooderLogs           BrooderLog[]
  eggCollectionSessions EggCollectionSession[]
  feedIntakeLogs        FeedIntakeLog[]
  flock_daily_entries   flock_daily_entries[]
  healthEvents          HealthEvent[]
  production_entries    production_entries[]
  storeMedicationLogs   StoreMedicationLog[]
  vaccinationRecords    VaccinationRecord[]

  @@index([houseId])
  @@index([stage])
  @@index([isActive])
  @@map("batches")
}

model BirdWeightSample {
  id             String   @id @default(uuid())
  batchId        String   @map("batch_id")
  sampleDate     DateTime @map("sample_date") @db.Date
  sampleCount    Int      @map("sample_count")
  totalWeightG   Int      @map("total_weight_g")
  averageWeightG Decimal  @map("average_weight_g") @db.Decimal(8, 2)
  ageWeeks       Int      @map("age_weeks")
  notes          String?
  recordedById   String   @map("recorded_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  batch          Batch    @relation(fields: [batchId], references: [id])

  @@index([batchId, sampleDate])
  @@map("bird_weight_samples")
}

model FeedDelivery {
  id            String   @id @default(uuid())
  feedType      FeedType @map("feed_type")
  supplierName  String   @map("supplier_name")
  quantityKg    Decimal  @map("quantity_kg") @db.Decimal(10, 2)
  pricePerKg    Decimal  @map("price_per_kg") @db.Decimal(10, 2)
  totalCost     Decimal  @map("total_cost") @db.Decimal(12, 2)
  deliveryDate  DateTime @map("delivery_date") @db.Date
  invoiceNumber String?  @map("invoice_number")
  notes         String?
  recordedById  String   @map("recorded_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([feedType, deliveryDate])
  @@map("feed_deliveries")
}

model FeedIntakeLog {
  id                  String      @id @default(uuid())
  batchId             String      @map("batch_id")
  houseId             String      @map("house_id")
  feedType            FeedType    @map("feed_type")
  entryDate           DateTime    @map("entry_date") @db.Date
  quantityDispensedKg Decimal     @map("quantity_dispensed_kg") @db.Decimal(8, 2)
  wastageKg           Decimal     @default(0) @map("wastage_kg") @db.Decimal(8, 2)
  recommendedMinKg    Decimal?    @map("recommended_min_kg") @db.Decimal(8, 2)
  recommendedMaxKg    Decimal?    @map("recommended_max_kg") @db.Decimal(8, 2)
  status              EntryStatus @default(PENDING)
  notes               String?
  recordedById        String      @map("recorded_by_id")
  approvedById        String?     @map("approved_by_id")
  approvedAt          DateTime?   @map("approved_at")
  returnReason        String?     @map("return_reason")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  userId              String?
  batch               Batch       @relation(fields: [batchId], references: [id])
  users               User?       @relation(fields: [userId], references: [id])

  @@unique([batchId, entryDate, feedType])
  @@index([batchId, entryDate])
  @@index([status])
  @@map("feed_intake_logs")
}

model FeedStockSnapshot {
  id              String   @id @default(uuid())
  feedType        FeedType @map("feed_type")
  snapshotDate    DateTime @map("snapshot_date") @db.Date
  stockKg         Decimal  @map("stock_kg") @db.Decimal(10, 2)
  avgDailyUsageKg Decimal  @map("avg_daily_usage_kg") @db.Decimal(8, 2)
  daysRemaining   Decimal  @map("days_remaining") @db.Decimal(6, 1)
  alertFired      Boolean  @default(false) @map("alert_fired")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([feedType, snapshotDate])
  @@map("feed_stock_snapshots")
}

model VaccinationSchedule {
  id           String              @id @default(uuid())
  vaccineName  String              @map("vaccine_name")
  birdType     BirdType            @map("bird_type")
  ageWeeks     Int                 @map("age_weeks")
  route        VaccinationRoute
  boosterWeeks Int?                @map("booster_weeks")
  isActive     Boolean             @default(true) @map("is_active")
  notes        String?
  createdAt    DateTime            @default(now()) @map("created_at")
  records      VaccinationRecord[]

  @@map("vaccination_schedule")
}

model VaccinationRecord {
  id               String               @id @default(uuid())
  batchId          String               @map("batch_id")
  scheduleId       String?              @map("schedule_id")
  vaccineName      String               @map("vaccine_name")
  administeredDate DateTime             @map("administered_date") @db.Date
  route            VaccinationRoute
  batchSize        Int                  @map("batch_size")
  dosageUnits      String?              @map("dosage_units")
  vetName          String?              @map("vet_name")
  notes            String?
  recordedById     String               @map("recorded_by_id")
  createdAt        DateTime             @default(now()) @map("created_at")
  batch            Batch                @relation(fields: [batchId], references: [id])
  schedule         VaccinationSchedule? @relation(fields: [scheduleId], references: [id])

  @@index([batchId])
  @@map("vaccination_records")
}

model HealthEvent {
  id            String          @id @default(uuid())
  batchId       String          @map("batch_id")
  eventType     HealthEventType @map("event_type")
  eventDate     DateTime        @map("event_date") @db.Date
  affectedCount Int             @map("affected_count")
  symptoms      String?
  diagnosis     String?
  treatment     String?
  outcome       String?
  isResolved    Boolean         @default(false) @map("is_resolved")
  resolvedAt    DateTime?       @map("resolved_at")
  recordedById  String          @map("recorded_by_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  batch         Batch           @relation(fields: [batchId], references: [id])
  vetReports    VetPdfReport[]

  @@index([batchId, eventDate])
  @@map("health_events")
}

model VetPdfReport {
  id            String       @id @default(uuid())
  batchId       String       @map("batch_id")
  healthEventId String?      @map("health_event_id")
  reportDate    DateTime     @map("report_date") @db.Date
  vetName       String       @map("vet_name")
  summary       String
  r2Key         String       @map("r2_key")
  r2Url         String       @map("r2_url")
  fileSizeBytes Int          @map("file_size_bytes")
  uploadedById  String       @map("uploaded_by_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  healthEvent   HealthEvent? @relation(fields: [healthEventId], references: [id])

  @@index([batchId])
  @@map("vet_pdf_reports")
}

model VisitorLog {
  id                String    @id @default(uuid())
  visitorName       String    @map("visitor_name")
  organisation      String?
  purpose           String
  checkInAt         DateTime  @map("check_in_at")
  checkOutAt        DateTime? @map("check_out_at")
  biosecurityChecks Json      @map("biosecurity_checks")
  houseId           String?   @map("house_id")
  recordedById      String    @map("recorded_by_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([checkInAt])
  @@map("visitor_log")
}

model EggCollectionSession {
  id                 String          @id @default(uuid())
  batchId            String          @map("batch_id")
  houseId            String          @map("house_id")
  sessionDate        DateTime        @map("session_date") @db.Date
  shift              String
  collectedById      String          @map("collected_by_id")
  openingPop         Int             @map("opening_pop")
  mortalities        Int             @default(0)
  closingStock       Int             @map("closing_stock")
  rowData            Json            @map("row_data")
  totalFullTrays     Int             @map("total_full_trays")
  totalLooseEggs     Int             @map("total_loose_eggs")
  totalBrokenEggs    Int             @default(0) @map("total_broken_eggs")
  totalSoftShell     Int             @default(0) @map("total_soft_shell")
  totalDeformed      Int             @default(0) @map("total_deformed")
  totalWeightKg      Decimal         @map("total_weight_kg") @db.Decimal(8, 2)
  totalGoodEggs      Int             @map("total_good_eggs")
  henDayPercent      Decimal?        @map("hen_day_percent") @db.Decimal(5, 2)
  vaccineGiven       String?         @map("vaccine_given")
  dailyFeedKg        Decimal?        @map("daily_feed_kg") @db.Decimal(8, 2)
  remarks            String?
  status             EntryStatus     @default(PENDING)
  returnReason       String?         @map("return_reason")
  verified_by_id     String?
  verified_at        DateTime?
  store_signed_by_id String?
  store_signed_at    DateTime?
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  batch              Batch           @relation(fields: [batchId], references: [id])
  storeIntakes       StoreEggIntake?

  @@unique([batchId, houseId, sessionDate, shift])
  @@index([houseId, sessionDate])
  @@index([status])
  @@map("egg_collection_sessions")
}

model StoreEggIntake {
  id              String               @id @default(uuid())
  sessionId       String               @unique @map("session_id")
  houseId         String               @map("house_id")
  intakeDate      DateTime             @map("intake_date") @db.Date
  shift           String
  receivedById    String               @map("received_by_id")
  rowData         Json                 @map("row_data")
  totalFullTrays  Int                  @map("total_full_trays")
  totalLooseEggs  Int                  @map("total_loose_eggs")
  totalGoodEggs   Int                  @map("total_good_eggs")
  totalWeightKg   Decimal              @map("total_weight_kg") @db.Decimal(8, 2)
  hasDiscrepancy  Boolean              @default(false) @map("has_discrepancy")
  discrepancyNote String?              @map("discrepancy_note")
  notes           String?
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  session         EggCollectionSession @relation(fields: [sessionId], references: [id])

  @@index([houseId, intakeDate])
  @@map("store_egg_intakes")
}

model DailyEggPrice {
  id                 String   @id @default(uuid())
  priceDate          DateTime @unique @map("price_date") @db.Date
  pricePerEgg        Decimal  @map("price_per_egg") @db.Decimal(8, 4)
  expectedRevenue    Decimal? @map("expected_revenue") @db.Decimal(12, 2)
  notes              String?
  setById            String   @map("set_by_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  pricePerEggStarter Decimal? @map("price_per_egg_starter") @db.Decimal(8, 4)
  pricePerEggBroken  Decimal? @map("price_per_egg_broken") @db.Decimal(8, 4)
  setBy              User     @relation(fields: [setById], references: [id])

  @@index([priceDate])
  @@map("daily_egg_prices")
}

model EggTallyVerification {
  id                 String    @id @default(uuid())
  sessionId          String    @unique @map("session_id")
  verificationDate   DateTime  @map("verification_date") @db.Date
  pmSignedById       String?   @map("pm_signed_by_id")
  pmSignedAt         DateTime? @map("pm_signed_at")
  pmRowData          Json?     @map("pm_row_data")
  salesSignedById    String?   @map("sales_signed_by_id")
  salesSignedAt      DateTime? @map("sales_signed_at")
  salesRowData       Json?     @map("sales_row_data")
  storeSignedById    String?   @map("store_signed_by_id")
  storeSignedAt      DateTime? @map("store_signed_at")
  storeRowData       Json?     @map("store_row_data")
  isLocked           Boolean   @default(false) @map("is_locked")
  lockedAt           DateTime? @map("locked_at")
  finalGoodEggs      Int?      @map("final_good_eggs")
  finalFullTrays     Int?      @map("final_full_trays")
  finalLooseEggs     Int?      @map("final_loose_eggs")
  expectedRevenueKes Decimal?  @map("expected_revenue_kes") @db.Decimal(12, 2)
  revenueSetById     String?   @map("revenue_set_by_id")
  revenueSetAt       DateTime? @map("revenue_set_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([verificationDate])
  @@index([sessionId])
  @@map("egg_tally_verifications")
}

model AdvanceBooking {
  id                 String        @id @default(uuid())
  bookingRef         String        @unique @map("booking_ref")
  customerId         String        @map("customer_id")
  createdById        String        @map("created_by_id")
  requestedDate      DateTime      @map("requested_date") @db.Date
  bookingDate        DateTime      @default(now()) @map("booking_date")
  quantityTrays      Int           @map("quantity_trays")
  quantityEggs       Int           @map("quantity_eggs")
  pricePerEggKes     Decimal       @map("price_per_egg_kes") @db.Decimal(8, 4)
  estimatedTotal     Decimal       @map("estimated_total") @db.Decimal(12, 2)
  stockLocked        Boolean       @default(true) @map("stock_locked")
  lockedAt           DateTime      @default(now()) @map("locked_at")
  unlockedAt         DateTime?     @map("unlocked_at")
  status             BookingStatus @default(PENDING)
  notes              String?
  cancellationReason String?       @map("cancellation_reason")
  salesOrderId       String?       @unique @map("sales_order_id")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  customer           Customer      @relation(fields: [customerId], references: [id])
  salesOrder         SalesOrder?   @relation(fields: [salesOrderId], references: [id])

  @@index([status])
  @@index([requestedDate])
  @@index([customerId])
  @@map("advance_bookings")
}

model InventoryMovement {
  id           String   @id @default(uuid())
  itemType     String   @map("item_type")
  grade        String?
  movementType String   @map("movement_type")
  quantity     Int
  referenceId  String?  @map("reference_id")
  notes        String?
  recordedById String   @map("recorded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([itemType, movementType])
  @@index([createdAt])
  @@map("inventory_movements")
}

model TemperatureLog {
  id           String   @id @default(uuid())
  locationId   String   @map("location_id")
  locationType String   @map("location_type")
  temperatureC Decimal  @map("temperature_c") @db.Decimal(4, 1)
  humidityPct  Decimal? @map("humidity_pct") @db.Decimal(4, 1)
  loggedAt     DateTime @map("logged_at")
  recordedById String   @map("recorded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([locationId, loggedAt])
  @@map("temperature_logs")
}

model Customer {
  id                       String                     @id @default(uuid())
  name                     String
  phone                    String?
  email                    String?
  address                  String?
  isActive                 Boolean                    @default(true) @map("is_active")
  creditDays               Int                        @default(0) @map("credit_days")
  createdAt                DateTime                   @default(now()) @map("created_at")
  updatedAt                DateTime                   @updatedAt @map("updated_at")
  deletedAt                DateTime?                  @map("deleted_at")
  advanceBookings          AdvanceBooking[]
  arEntries                ArEntry[]
  deliveryLogs             DeliveryLog[]
  egg_breakage_adjustments egg_breakage_adjustments[]
  invoices                 Invoice[]
  salesOrders              SalesOrder[]

  @@map("customers")
}

model SalesOrder {
  id                       String                     @id @default(uuid())
  orderNumber              String                     @unique @map("order_number")
  customerId               String                     @map("customer_id")
  orderDate                DateTime                   @map("order_date") @db.Date
  status                   OrderStatus                @default(PENDING)
  deliveryDate             DateTime?                  @map("delivery_date") @db.Date
  deliveryAddress          String?                    @map("delivery_address")
  tier                     SalesTier
  subtotal                 Decimal                    @db.Decimal(12, 2)
  notes                    String?
  createdById              String                     @map("created_by_id")
  confirmedAt              DateTime?                  @map("confirmed_at")
  createdAt                DateTime                   @default(now()) @map("created_at")
  updatedAt                DateTime                   @updatedAt @map("updated_at")
  bankRef                  String?                    @map("bank_ref")
  mpesaRef                 String?                    @map("mpesa_ref")
  advanceBooking           AdvanceBooking?
  deliveryLogs             DeliveryLog[]
  egg_breakage_adjustments egg_breakage_adjustments[]
  invoices                 Invoice[]
  items                    SalesOrderItem[]
  customer                 Customer                   @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([orderDate])
  @@map("sales_orders")
}

model SalesOrderItem {
  id            String     @id @default(uuid())
  orderId       String     @map("order_id")
  itemType      String     @map("item_type")
  grade         String?
  quantityTrays Int?       @map("quantity_trays")
  quantityKg    Decimal?   @map("quantity_kg") @db.Decimal(8, 2)
  unitPrice     Decimal    @map("unit_price") @db.Decimal(10, 2)
  subtotal      Decimal    @db.Decimal(12, 2)
  order         SalesOrder @relation(fields: [orderId], references: [id])

  @@map("sales_order_items")
}

model Invoice {
  id            String           @id @default(uuid())
  invoiceNumber String           @unique @map("invoice_number")
  salesOrderId  String?          @map("sales_order_id")
  customerId    String           @map("customer_id")
  invoiceDate   DateTime         @map("invoice_date") @db.Date
  dueDate       DateTime         @map("due_date") @db.Date
  subtotal      Decimal          @db.Decimal(12, 2)
  taxAmount     Decimal          @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount   Decimal          @map("total_amount") @db.Decimal(12, 2)
  paidAmount    Decimal          @default(0) @map("paid_amount") @db.Decimal(12, 2)
  balanceDue    Decimal          @map("balance_due") @db.Decimal(12, 2)
  status        InvoiceStatus    @default(UNPAID)
  pdfR2Key      String?          @map("pdf_r2_key")
  notes         String?
  createdById   String           @map("created_by_id")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  arEntry       ArEntry?
  payments      InvoicePayment[]
  customer      Customer         @relation(fields: [customerId], references: [id])
  salesOrder    SalesOrder?      @relation(fields: [salesOrderId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model InvoicePayment {
  id            String   @id @default(uuid())
  invoiceId     String   @map("invoice_id")
  paymentDate   DateTime @map("payment_date") @db.Date
  amount        Decimal  @db.Decimal(12, 2)
  paymentMethod String   @map("payment_method")
  reference     String?
  notes         String?
  recordedById  String   @map("recorded_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("invoice_payments")
}

model ArEntry {
  id             String   @id @default(uuid())
  invoiceId      String   @unique @map("invoice_id")
  customerId     String   @map("customer_id")
  originalAmount Decimal  @map("original_amount") @db.Decimal(12, 2)
  currentBalance Decimal  @map("current_balance") @db.Decimal(12, 2)
  dueDate        DateTime @map("due_date") @db.Date
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  customer       Customer @relation(fields: [customerId], references: [id])
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])

  @@index([customerId])
  @@index([dueDate])
  @@map("ar_entries")
}

model ExpenseLog {
  id              String          @id @default(uuid())
  description     String
  amount          Decimal         @db.Decimal(12, 2)
  expenseDate     DateTime        @map("expense_date") @db.Date
  batchId         String?         @map("batch_id")
  vendorName      String?         @map("vendor_name")
  receiptRef      String?         @map("receipt_ref")
  recordedById    String          @map("recorded_by_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  categoryId      String          @map("category_id")
  expenseCategory ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([categoryId, expenseDate])
  @@index([batchId])
  @@map("expense_logs")
}

model ExpenseCategory {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  isActive    Boolean      @default(true) @map("is_active")
  createdById String       @map("created_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  createdBy   User         @relation("ExpenseCategoryCreatedBy", fields: [createdById], references: [id])
  expenses    ExpenseLog[]

  @@map("expense_categories")
}

model EggPriceSchedule {
  id                 String   @id @default(uuid())
  effectiveDate      DateTime @map("effective_date") @db.Date
  retailPerTray      Decimal  @map("retail_per_tray") @db.Decimal(10, 2)
  wholesalePerTray   Decimal  @map("wholesale_per_tray") @db.Decimal(10, 2)
  brokenSellableEach Decimal  @map("broken_sellable_each") @db.Decimal(8, 4)
  notes              String?
  setById            String   @map("set_by_id")
  createdAt          DateTime @default(now()) @map("created_at")
  setBy              User     @relation("EggPriceScheduleSetBy", fields: [setById], references: [id])

  @@index([effectiveDate(sort: Desc)])
  @@map("egg_price_schedules")
}

model AiReport {
  id          String    @id @default(uuid())
  reportType  String    @map("report_type")
  weekEnding  DateTime? @map("week_ending") @db.Date
  content     String
  rawData     Json      @map("raw_data")
  generatedAt DateTime  @default(now()) @map("generated_at")

  @@index([reportType, weekEnding])
  @@map("ai_reports")
}

model Notification {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  type       NotificationType
  title      String
  message    String
  entityId   String?          @map("entity_id")
  entityType String?          @map("entity_type")
  isRead     Boolean          @default(false) @map("is_read")
  readAt     DateTime?        @map("read_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  user       User             @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}

model PasswordResetLog {
  id           String   @id @default(uuid())
  targetUserId String   @map("target_user_id")
  adminId      String   @map("admin_id")
  resetType    String   @default("ADMIN_RESET") @map("reset_type")
  createdAt    DateTime @default(now()) @map("created_at")
  admin        User     @relation("PasswordResetAdmin", fields: [adminId], references: [id])
  targetUser   User     @relation("PasswordResetTarget", fields: [targetUserId], references: [id])

  @@map("password_reset_logs")
}

model DeliveryLog {
  id            String      @id @default(uuid())
  deliveryRef   String      @unique @map("delivery_ref")
  deliveryDate  DateTime    @map("delivery_date") @db.Date
  route         String
  destination   String
  customerId    String?     @map("customer_id")
  driverName    String?     @map("driver_name")
  vehiclePlate  String?     @map("vehicle_plate")
  quantityTrays Int         @map("quantity_trays")
  quantityEggs  Int         @map("quantity_eggs")
  notes         String?
  status        String      @default("PENDING")
  failureReason String?     @map("failure_reason")
  deliveredAt   DateTime?   @map("delivered_at")
  loggedById    String      @map("logged_by_id")
  salesOrderId  String?     @map("sales_order_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  customer      Customer?   @relation(fields: [customerId], references: [id])
  loggedBy      User        @relation("DeliveryLogsLogged", fields: [loggedById], references: [id])
  salesOrder    SalesOrder? @relation(fields: [salesOrderId], references: [id])

  @@index([deliveryDate])
  @@index([status])
  @@index([route])
  @@map("delivery_logs")
}

model StoreMedicationLog {
  id             String   @id @default(uuid())
  batchId        String   @map("batch_id")
  houseId        String   @map("house_id")
  logDate        DateTime @map("log_date") @db.Date
  medicationName String   @map("medication_name")
  dosage         String?
  quantityUnits  String?  @map("quantity_units")
  costKes        Decimal  @default(0) @map("cost_kes") @db.Decimal(12, 2)
  notes          String?
  loggedById     String   @map("logged_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  batch          Batch    @relation(fields: [batchId], references: [id])
  loggedBy       User     @relation("StoreMedicationLoggedBy", fields: [loggedById], references: [id])

  @@index([batchId, logDate])
  @@index([logDate])
  @@map("store_medication_logs")
}

model StoreEquipmentLog {
  id            String   @id @default(uuid())
  logDate       DateTime @map("log_date") @db.Date
  equipmentName String   @map("equipment_name")
  eventType     String   @map("event_type")
  description   String?
  costKes       Decimal  @default(0) @map("cost_kes") @db.Decimal(12, 2)
  vendorName    String?  @map("vendor_name")
  notes         String?
  loggedById    String   @map("logged_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  loggedBy      User     @relation("StoreEquipmentLoggedBy", fields: [loggedById], references: [id])

  @@index([logDate])
  @@map("store_equipment_logs")
}

model StoreWorkerAssignment {
  id            String   @id @default(uuid())
  weekStartDate DateTime @map("week_start_date") @db.Date
  workerName    String   @map("worker_name")
  houseId       String   @map("house_id")
  roleTitle     String?  @map("role_title")
  salaryKes     Decimal  @default(0) @map("salary_kes") @db.Decimal(12, 2)
  notes         String?
  loggedById    String   @map("logged_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  house         House    @relation(fields: [houseId], references: [id])
  loggedBy      User     @relation("StoreWorkerAssignmentLoggedBy", fields: [loggedById], references: [id])

  @@index([weekStartDate])
  @@index([houseId])
  @@map("store_worker_assignments")
}

model HealthChecklist {
  id            String   @id @default(uuid())
  checkDate     DateTime @map("check_date") @db.Date
  shift         String   @default("AM")
  houseId       String?  @map("house_id")
  submittedById String   @map("submitted_by_id")
  checks        Json     @default("{}")
  itemNotes     Json     @default("{}") @map("item_notes")
  overallNotes  String?  @map("overall_notes")
  failCount     Int      @default(0) @map("fail_count")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([checkDate])
  @@index([submittedById])
  @@map("health_checklists")
}

model BiosecurityLog {
  id             String   @id @default(uuid())
  logDate        DateTime @map("log_date") @db.Date
  checkpointType String   @map("checkpoint_type")
  loggedById     String   @map("logged_by_id")
  checks         Json     @default("{}")
  itemNotes      Json     @default("{}") @map("item_notes")
  overallNotes   String?  @map("overall_notes")
  failCount      Int      @default(0) @map("fail_count")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([logDate])
  @@index([checkpointType])
  @@map("biosecurity_logs")
}

model VisitorAdvanceNotice {
  id            String    @id @default(uuid())
  expectedDate  DateTime  @map("expected_date") @db.Date
  visitorName   String    @map("visitor_name")
  organisation  String?
  purpose       String
  expectedCount Int       @default(1) @map("expected_count")
  houseIds      String[]  @map("house_ids")
  requestedById String    @map("requested_by_id")
  status        String    @default("PENDING")
  directorNote  String?   @map("director_note")
  approvedById  String?   @map("approved_by_id")
  approvedAt    DateTime? @map("approved_at")
  visitorLogId  String?   @map("visitor_log_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([expectedDate])
  @@index([status])
  @@map("visitor_advance_notices")
}

model BrooderLog {
  id                String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  batchId           String   @map("batch_id")
  logDate           DateTime @map("log_date") @db.Date
  waterConsumptionL Float?   @map("water_consumption_l")
  temperature       Float?
  lightingOk        Boolean  @default(true) @map("lighting_ok")
  mortalityCount    Int      @default(0) @map("mortality_count")
  vaccineGiven      String?  @map("vaccine_given")
  supplement        String?
  notes             String?
  loggedById        String   @map("logged_by_id")
  createdAt         DateTime @default(now()) @map("created_at")
  batch             Batch    @relation(fields: [batchId], references: [id])
  loggedBy          User     @relation("BrooderLoggedBy", fields: [loggedById], references: [id])

  @@index([batchId, logDate])
  @@map("brooder_logs")
}

model FarmBlock {
  id                  String          @id @default(uuid())
  code                String          @unique
  name                String
  isActive            Boolean         @default(true) @map("is_active")
  isUnderConstruction Boolean         @default(false) @map("is_under_construction")
  created_at          DateTime        @default(now())
  farm_sections       farm_sections[]

  @@map("farm_blocks")
}

model BatchCageAssignment {
  id           String    @id @default(uuid())
  rowId        String    @unique @map("row_id")
  batchId      String    @map("batch_id")
  transferDate DateTime  @map("transfer_date") @db.Date
  notes        String?
  assignedById String    @map("assigned_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  row          farm_rows @relation("ActiveCageAssignment", fields: [rowId], references: [id])

  @@map("batch_cage_assignments")
}

model accountant_export_layouts {
  id             String   @id
  layout_config  Json
  uploaded_by_id String
  created_at     DateTime @default(now())
  updated_at     DateTime
}

model accountant_price_references {
  id                 String   @id
  ref_date           DateTime @db.Date
  competitor_name    String
  price_per_tray_kes Decimal  @db.Decimal(10, 2)
  market             String?
  uploaded_by_id     String
  uploaded_at        DateTime @default(now())
}

model accountant_qb_expense_uploads {
  id             String   @id
  month          String
  category       String
  amount_kes     Decimal  @db.Decimal(12, 2)
  description    String?
  uploaded_by_id String
  uploaded_at    DateTime @default(now())
}

model egg_breakage_adjustments {
  id                                                   String                   @id
  adjustment_ref                                       String                   @unique
  adjustment_date                                      DateTime                 @db.Date
  sales_order_id                                       String?
  customer_id                                          String?
  grade                                                EggGrade
  quantity_trays                                       Int                      @default(0)
  quantity_eggs                                        Int                      @default(0)
  unit_price_kes                                       Decimal                  @db.Decimal(10, 2)
  total_value_kes                                      Decimal                  @db.Decimal(12, 2)
  reason                                               BreakageReason
  notes                                                String?
  status                                               BreakageAdjustmentStatus @default(PENDING)
  review_notes                                         String?
  reported_by_id                                       String
  reviewed_by_id                                       String?
  reviewed_at                                          DateTime?
  created_at                                           DateTime                 @default(now())
  updated_at                                           DateTime
  customers                                            Customer?                @relation(fields: [customer_id], references: [id])
  users_egg_breakage_adjustments_reported_by_idTousers User                     @relation("egg_breakage_adjustments_reported_by_idTousers", fields: [reported_by_id], references: [id])
  users_egg_breakage_adjustments_reviewed_by_idTousers User?                    @relation("egg_breakage_adjustments_reviewed_by_idTousers", fields: [reviewed_by_id], references: [id])
  sales_orders                                         SalesOrder?              @relation(fields: [sales_order_id], references: [id])

  @@index([adjustment_date])
  @@index([sales_order_id])
  @@index([status])
}

model egg_price_tiers {
  id             String    @id
  tier           SalesTier
  min_trays      Int
  max_trays      Int?
  price_per_tray Decimal   @db.Decimal(10, 2)
  is_active      Boolean   @default(true)
  effective_from DateTime  @db.Date
  effective_to   DateTime? @db.Date
  created_at     DateTime  @default(now())
}

model farm_rows {
  id            String               @id
  section_id    String
  row_code      String
  is_active     Boolean              @default(true)
  assignments   BatchCageAssignment? @relation("ActiveCageAssignment")
  farm_sections farm_sections        @relation(fields: [section_id], references: [id])

  @@unique([section_id, row_code])
}

model farm_sections {
  id          String      @id
  block_id    String
  code        String
  sort_order  Int         @default(0)
  farm_rows   farm_rows[]
  farm_blocks FarmBlock   @relation(fields: [block_id], references: [id])

  @@unique([block_id, code])
}

model flock_daily_entries {
  id                                               String          @id
  batch_id                                         String
  house_id                                         String
  entry_date                                       DateTime        @db.Date
  shift                                            String          @default("AM")
  opening_count                                    Int
  mortality_count                                  Int             @default(0)
  mortality_cause                                  MortalityCause?
  culling_count                                    Int             @default(0)
  culling_reason                                   String?
  closing_count                                    Int
  water_consumption_l                              Decimal?        @db.Decimal(8, 2)
  temperature_celsius                              Decimal?        @db.Decimal(4, 1)
  humidity_percent                                 Decimal?        @db.Decimal(4, 1)
  notes                                            String?
  status                                           EntryStatus     @default(PENDING)
  submitted_by_id                                  String
  approved_by_id                                   String?
  approved_at                                      DateTime?
  return_reason                                    String?
  created_at                                       DateTime        @default(now())
  updated_at                                       DateTime
  users_flock_daily_entries_approved_by_idTousers  User?           @relation("flock_daily_entries_approved_by_idTousers", fields: [approved_by_id], references: [id])
  batches                                          Batch           @relation(fields: [batch_id], references: [id])
  users_flock_daily_entries_submitted_by_idTousers User            @relation("flock_daily_entries_submitted_by_idTousers", fields: [submitted_by_id], references: [id])

  @@unique([batch_id, entry_date, shift])
  @@index([batch_id, entry_date])
  @@index([status])
  @@index([submitted_by_id])
}

model historical_cost_records {
  id                     String                 @id
  upload_log_id          String
  date                   DateTime               @db.Date
  category               String
  description            String
  total_cost_kes         Decimal                @db.Decimal(12, 2)
  quantity               Decimal?               @db.Decimal(12, 3)
  unit                   String?
  unit_cost_kes          Decimal?               @db.Decimal(10, 2)
  supplier               String?
  batch_code             String?
  historical_upload_logs historical_upload_logs @relation(fields: [upload_log_id], references: [id])
}

model historical_production_records {
  id                     String                 @id
  upload_log_id          String
  date                   DateTime               @db.Date
  good_eggs              Int
  broken_eggs            Int                    @default(0)
  bird_count             Int
  mortality              Int                    @default(0)
  batch_code             String?
  notes                  String?
  historical_upload_logs historical_upload_logs @relation(fields: [upload_log_id], references: [id])
}

model historical_sales_records {
  id                     String                 @id
  upload_log_id          String
  invoice_date           DateTime               @db.Date
  invoice_number         String                 @unique
  customer_name          String
  quantity_trays         Int
  total_kes              Decimal                @db.Decimal(12, 2)
  unit_price_kes         Decimal?               @db.Decimal(10, 2)
  payment_method         String?
  payment_date           DateTime?              @db.Date
  payment_reference      String?
  historical_upload_logs historical_upload_logs @relation(fields: [upload_log_id], references: [id])
}

model historical_upload_logs {
  id                            String                          @id
  template_id                   String?
  upload_type                   String
  file_name                     String
  records_imported              Int                             @default(0)
  date_from                     DateTime?                       @db.Date
  date_to                       DateTime?                       @db.Date
  uploaded_by_id                String
  uploaded_at                   DateTime                        @default(now())
  historical_cost_records       historical_cost_records[]
  historical_production_records historical_production_records[]
  historical_sales_records      historical_sales_records[]
  named_upload_templates        named_upload_templates?         @relation(fields: [template_id], references: [id])
}

model named_upload_templates {
  id                     String                   @id
  name                   String
  category               String
  column_mapping         Json
  created_by_id          String
  created_at             DateTime                 @default(now())
  historical_upload_logs historical_upload_logs[]
}

model production_entries {
  id               String      @id
  batch_id         String
  house_id         String
  entry_date       DateTime    @db.Date
  shift            String      @default("AM")
  eggs_small       Int         @default(0)
  eggs_medium      Int         @default(0)
  eggs_large       Int         @default(0)
  eggs_extra_large Int         @default(0)
  eggs_reject      Int         @default(0)
  total_eggs       Int
  hen_day_percent  Decimal?    @db.Decimal(5, 2)
  status           EntryStatus @default(PENDING)
