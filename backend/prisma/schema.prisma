// ═══════════════════════════════════════════════════════════════════════════
// PHASE 2: STORE INVENTORY MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════

model StoreItem {
  id          String             @id @default(uuid())
  name        String
  sku         String             @unique
  category    StoreItemCategory
  unit        StoreItemUnit
  description String?
  reorderLevel Decimal           @default(0) @map("reorder_level") @db.Decimal(10, 3)
  currentStock Decimal           @default(0) @map("current_stock") @db.Decimal(10, 3)
  unitCostKes  Decimal           @default(0) @map("unit_cost_kes") @db.Decimal(10, 2)
  supplierId   String?           @map("supplier_id")
  isActive     Boolean           @default(true) @map("is_active")
  createdById  String            @map("created_by_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  stockIns                StoreStockIn[]
  stockOuts               StoreStockOut[]
  purchaseRequestItems    PurchaseRequestItem[]
  lpoItems                LPOItem[]
  simpleStockRequestItems SimpleStockRequestItem[]

  @@index([category])
  @@index([isActive])
  @@map("store_items")
}

model StoreStockIn {
  id            String   @id @default(uuid())
  storeItemId   String   @map("store_item_id")
  receivedDate  DateTime @map("received_date") @db.Date
  quantityIn    Decimal  @map("quantity_in") @db.Decimal(10, 3)
  unitCostKes   Decimal  @map("unit_cost_kes") @db.Decimal(10, 2)
  totalCostKes  Decimal  @map("total_cost_kes") @db.Decimal(12, 2)
  supplierName  String?  @map("supplier_name")
  invoiceRef    String?  @map("invoice_ref")
  lpoId         String?  @map("lpo_id")
  notes         String?
  receivedById  String   @map("received_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  storeItem  StoreItem           @relation(fields: [storeItemId], references: [id])
  receivedBy User                @relation("StoreStockInReceivedBy", fields: [receivedById], references: [id])
  lpo        LocalPurchaseOrder? @relation(fields: [lpoId], references: [id])

  @@index([storeItemId, receivedDate])
  @@index([receivedDate])
  @@map("store_stock_ins")
}

model StoreStockOut {
  id              String   @id @default(uuid())
  storeItemId     String   @map("store_item_id")
  issuedDate      DateTime @map("issued_date") @db.Date
  quantityOut     Decimal  @map("quantity_out") @db.Decimal(10, 3)
  unitCostKes     Decimal  @map("unit_cost_kes") @db.Decimal(10, 2)
  totalCostKes    Decimal  @map("total_cost_kes") @db.Decimal(12, 2)
  issuedToHouseId String?  @map("issued_to_house_id")
  issuedToBatchId String?  @map("issued_to_batch_id")
  purpose         String?
  notes           String?
  issuedById      String   @map("issued_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  storeItem               StoreItem                @relation(fields: [storeItemId], references: [id])
  issuedBy                User                     @relation("StoreStockOutIssuedBy", fields: [issuedById], references: [id])
  simpleStockRequestItems SimpleStockRequestItem[]

  @@index([storeItemId, issuedDate])
  @@index([issuedDate])
  @@map("store_stock_outs")
}

// ─── PURCHASE REQUEST (Store → Accountant → LPO → Director) ──────────────
// Exists already — kept as-is.

model PurchaseRequest {
  id            String                @id @default(uuid())
  requestRef    String                @unique @map("request_ref")
  requestDate   DateTime              @map("request_date") @db.Date
  status        PurchaseRequestStatus @default(DRAFT)
  urgency       String                @default("NORMAL")
  notes         String?
  reviewNotes   String?               @map("review_notes")
  createdById   String                @map("created_by_id")
  reviewedById  String?               @map("reviewed_by_id")
  reviewedAt    DateTime?             @map("reviewed_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  createdBy   User                  @relation("PurchaseRequestCreatedBy",  fields: [createdById],  references: [id])
  reviewedBy  User?                 @relation("PurchaseRequestReviewedBy", fields: [reviewedById], references: [id])
  items       PurchaseRequestItem[]
  lpo         LocalPurchaseOrder?

  @@index([status])
  @@index([requestDate])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                String  @id @default(uuid())
  purchaseRequestId String  @map("purchase_request_id")
  storeItemId       String  @map("store_item_id")
  quantityRequested Decimal @map("quantity_requested") @db.Decimal(10, 3)
  estimatedUnitCost Decimal @default(0) @map("estimated_unit_cost") @db.Decimal(10, 2)
  reason            String?

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  storeItem       StoreItem       @relation(fields: [storeItemId], references: [id])

  @@map("purchase_request_items")
}

// ─── SIMPLE STOCK REQUEST (PM/Sales/Accountant → Store) ──────────────────
// Distinct from PurchaseRequest. Store fulfils by issuing a StoreStockOut.

model SimpleStockRequest {
  id               String                   @id @default(uuid())
  requestRef       String                   @unique @map("request_ref")
  requestDate      DateTime                 @map("request_date") @db.Date
  neededBy         DateTime?                @map("needed_by") @db.Date
  status           SimpleStockRequestStatus @default(PENDING)
  purpose          String?
  notes            String?
  rejectionReason  String?                  @map("rejection_reason")
  requestedById    String                   @map("requested_by_id")
  fulfilledById    String?                  @map("fulfilled_by_id")
  fulfilledAt      DateTime?                @map("fulfilled_at")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  requestedBy User  @relation("SimpleStockRequestCreatedBy",   fields: [requestedById], references: [id])
  fulfilledBy User? @relation("SimpleStockRequestFulfilledBy", fields: [fulfilledById], references: [id])
  items       SimpleStockRequestItem[]

  @@index([status])
  @@index([requestDate])
  @@map("simple_stock_requests")
}

model SimpleStockRequestItem {
  id                 String  @id @default(uuid())
  requestId          String  @map("request_id")
  storeItemId        String  @map("store_item_id")
  quantityRequested  Decimal @map("quantity_requested") @db.Decimal(10, 3)
  quantityIssued     Decimal @default(0) @map("quantity_issued") @db.Decimal(10, 3)
  stockOutId         String? @map("stock_out_id")
  notes              String?

  request   SimpleStockRequest @relation(fields: [requestId],   references: [id], onDelete: Cascade)
  storeItem StoreItem          @relation(fields: [storeItemId], references: [id])
  stockOut  StoreStockOut?     @relation(fields: [stockOutId],  references: [id])

  @@map("simple_stock_request_items")
}

// ─── LOCAL PURCHASE ORDER ────────────────────────────────────────────────

model LocalPurchaseOrder {
  id                String    @id @default(uuid())
  lpoNumber         String    @unique @map("lpo_number")
  purchaseRequestId String?   @unique @map("purchase_request_id")
  supplierId        String?   @map("supplier_id")
  supplierName      String    @map("supplier_name")
  lpoDate           DateTime  @map("lpo_date") @db.Date
  expectedDelivery  DateTime? @map("expected_delivery") @db.Date
  status            LPOStatus @default(DRAFT)
  subtotalKes       Decimal   @map("subtotal_kes") @db.Decimal(12, 2)
  vatKes            Decimal   @default(0) @map("vat_kes") @db.Decimal(12, 2)
  totalKes          Decimal   @map("total_kes") @db.Decimal(12, 2)
  notes             String?
  approvedById      String?   @map("approved_by_id")
  approvedAt        DateTime? @map("approved_at")
  createdById       String    @map("created_by_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  supplier        Supplier?        @relation(fields: [supplierId],        references: [id])
  createdBy       User             @relation("LPOCreatedBy",              fields: [createdById], references: [id])
  approvedBy      User?            @relation("LPOApprovedBy",             fields: [approvedById], references: [id])
  items           LPOItem[]
  stockIns        StoreStockIn[]

  @@index([status])
  @@index([lpoDate])
  @@map("local_purchase_orders")
}

model LPOItem {
  id          String  @id @default(uuid())
  lpoId       String  @map("lpo_id")
  storeItemId String  @map("store_item_id")
  description String?
  quantity    Decimal @db.Decimal(10, 3)
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  subtotal    Decimal @db.Decimal(12, 2)

  lpo       LocalPurchaseOrder @relation(fields: [lpoId],       references: [id], onDelete: Cascade)
  storeItem StoreItem          @relation(fields: [storeItemId], references: [id])

  @@map("lpo_items")
}

// ─── PHASE 2: FARM EMPLOYEES ──────────────────────────────────────────────────

model FarmEmployee {
  id             String         @id @default(uuid())
  fullName       String         @map("full_name")
  nationalId     String?        @unique @map("national_id")
  phone          String?
  role           String
  houseIds       String[]       @map("house_ids")
  salaryKes      Decimal        @default(0) @map("salary_kes") @db.Decimal(10, 2)
  payPeriod      String         @default("MONTHLY") @map("pay_period")
  hireDate       DateTime       @map("hire_date") @db.Date
  terminatedDate DateTime?      @map("terminated_date") @db.Date
  status         EmployeeStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([status])
  @@map("farm_employees")
}

// ─── PHASE 2: CONSTRUCTION RECORDS ───────────────────────────────────────────

model ConstructionRecord {
  id               String           @id @default(uuid())
  title            String
  constructionType ConstructionType @map("construction_type")
  location         String
  startDate        DateTime         @map("start_date") @db.Date
  endDate          DateTime?        @map("end_date") @db.Date
  contractorName   String?          @map("contractor_name")
  contractorPhone  String?          @map("contractor_phone")
  budgetKes        Decimal          @default(0) @map("budget_kes") @db.Decimal(12, 2)
  actualCostKes    Decimal          @default(0) @map("actual_cost_kes") @db.Decimal(12, 2)
  status           String           @default("IN_PROGRESS")
  description      String?
  notes            String?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  laborRecords ConstructionLaborRecord[]

  @@index([status])
  @@index([startDate])
  @@map("construction_records")
}

// ─── NEW: CONSTRUCTION LABOR RECORDS (mandated for STORE) ────────────────

model ConstructionLaborRecord {
  id                   String    @id @default(uuid())
  constructionRecordId String?   @map("construction_record_id")
  workDate             DateTime  @map("work_date") @db.Date
  workerName           String    @map("worker_name")
  roleTitle            String?   @map("role_title")
  hoursWorked          Decimal   @default(0) @map("hours_worked") @db.Decimal(5, 2)
  ratePerHourKes       Decimal   @default(0) @map("rate_per_hour_kes") @db.Decimal(10, 2)
  totalPayKes          Decimal   @default(0) @map("total_pay_kes") @db.Decimal(12, 2)
  notes                String?
  loggedById           String    @map("logged_by_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  constructionRecord ConstructionRecord? @relation(fields: [constructionRecordId], references: [id])
  loggedBy           User                @relation("ConstructionLaborLoggedBy", fields: [loggedById], references: [id])

  @@index([workDate])
  @@index([constructionRecordId])
  @@map("construction_labor_records")
}

// ─── CAGE MAP (Phase 7 Addendum B) — soft-delete enabled ─────────────────

model FarmBlock {
  id                  String   @id @default(uuid())
  code                String   @unique
  name                String
  isActive            Boolean  @default(true) @map("is_active")
  isUnderConstruction Boolean  @default(false) @map("is_under_construction")

  sections CageSection[]

  @@map("farm_blocks")
}

model CageSection {
  id        String  @id @default(uuid())
  blockId   String  @map("block_id")
  code      String
  sortOrder Int     @default(0) @map("sort_order")

  block FarmBlock @relation(fields: [blockId], references: [id])
  rows  CageRow[]

  @@unique([blockId, code])
  @@map("cage_sections")
}

model CageRow {
  id        String  @id @default(uuid())
  sectionId String  @map("section_id")
  rowCode   String  @map("row_code")
  isActive  Boolean @default(true) @map("is_active")

  section    CageSection           @relation(fields: [sectionId], references: [id])
  assignments BatchCageAssignment[] @relation("ActiveCageAssignment")

  @@unique([sectionId, rowCode])
  @@map("cage_rows")
}

// One historical row per (rowId, batch transfer). Only one row may have
// is_active = true per rowId — enforced by partial unique index in migration.
model BatchCageAssignment {
  id                String    @id @default(uuid())
  rowId             String    @map("row_id")
  batchId           String    @map("batch_id")
  transferDate      DateTime  @map("transfer_date") @db.Date
  notes             String?
  assignedById      String    @map("assigned_by_id")
  isActive          Boolean   @default(true) @map("is_active")
  deactivatedAt     DateTime? @map("deactivated_at")
  deactivatedById   String?   @map("deactivated_by_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  row           CageRow @relation("ActiveCageAssignment", fields: [rowId], references: [id])
  assignedBy    User    @relation("CageAssignmentAssignedBy",    fields: [assignedById],    references: [id])
  deactivatedBy User?   @relation("CageAssignmentDeactivatedBy", fields: [deactivatedById], references: [id])

  @@index([batchId])
  @@index([rowId, isActive])
  @@map("batch_cage_assignments")
}
