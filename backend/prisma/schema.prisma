// ═══════════════════════════════════════════════════════════════════════════
// ─── PHASE 2: STORE INVENTORY MANAGEMENT ─────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════

/// Master catalogue of items stocked in the store
model StoreItem {
  id          String             @id @default(uuid())
  name        String
  sku         String             @unique
  category    StoreItemCategory
  unit        StoreItemUnit
  description String?
  reorderLevel Decimal           @default(0) @map("reorder_level") @db.Decimal(10, 3)
  currentStock Decimal           @default(0) @map("current_stock") @db.Decimal(10, 3)
  unitCostKes  Decimal           @default(0) @map("unit_cost_kes") @db.Decimal(10, 2)
  supplierId   String?           @map("supplier_id")
  isActive     Boolean           @default(true) @map("is_active")
  createdById  String            @map("created_by_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  stockIns        StoreStockIn[]
  stockOuts       StoreStockOut[]
  purchaseRequestItems PurchaseRequestItem[]
  lpoItems        LPOItem[]
  simpleStockRequestItems SimpleStockRequestItem[]

  @@index([category])
  @@index([isActive])
  @@map("store_items")
}

/// Goods received into store (from purchase / delivery)
model StoreStockIn {
  id            String   @id @default(uuid())
  storeItemId   String   @map("store_item_id")
  receivedDate  DateTime @map("received_date") @db.Date
  quantityIn    Decimal  @map("quantity_in") @db.Decimal(10, 3)
  unitCostKes   Decimal  @map("unit_cost_kes") @db.Decimal(10, 2)
  totalCostKes  Decimal  @map("total_cost_kes") @db.Decimal(12, 2)
  supplierName  String?  @map("supplier_name")
  invoiceRef    String?  @map("invoice_ref")
  lpoId         String?  @map("lpo_id")
  notes         String?
  receivedById  String   @map("received_by_id")
  expiryDate    DateTime? @map("expiry_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")

  storeItem     StoreItem           @relation(fields: [storeItemId], references: [id])
  receivedBy    User                @relation("StoreStockInReceivedBy", fields: [receivedById], references: [id])
  lpo           LocalPurchaseOrder? @relation(fields: [lpoId], references: [id])

  @@index([storeItemId, receivedDate])
  @@index([receivedDate])
  @@map("store_stock_ins")
}

/// Items issued out of store (to houses/batches)
model StoreStockOut {
  id            String   @id @default(uuid())
  storeItemId   String   @map("store_item_id")
  issuedDate    DateTime @map("issued_date") @db.Date
  quantityOut   Decimal  @map("quantity_out") @db.Decimal(10, 3)
  unitCostKes   Decimal  @map("unit_cost_kes") @db.Decimal(10, 2)
  totalCostKes  Decimal  @map("total_cost_kes") @db.Decimal(12, 2)
  issuedToName    String? @map("issued_to_name")
  issuedToHouseId String? @map("issued_to_house_id")
  issuedToBatchId String? @map("issued_to_batch_id")
  purpose       String?
  notes         String?
  issuedById    String   @map("issued_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  storeItem        StoreItem                @relation(fields: [storeItemId], references: [id])
  issuedBy         User                     @relation("StoreStockOutIssuedBy", fields: [issuedById], references: [id])
  stockRequestItem SimpleStockRequestItem?

  @@index([storeItemId, issuedDate])
  @@index([issuedDate])
  @@map("store_stock_outs")
}

/// Purchase request raised by Store, reviewed by Accountant
model PurchaseRequest {
  id            String                @id @default(uuid())
  requestRef    String                @unique @map("request_ref")
  requestDate   DateTime              @map("request_date") @db.Date
  status        PurchaseRequestStatus @default(DRAFT)
  urgency       String                @default("NORMAL") // LOW | NORMAL | URGENT
  notes         String?
  reviewNotes   String?               @map("review_notes")
  createdById   String                @map("created_by_id")
  reviewedById  String?               @map("reviewed_by_id")
  reviewedAt    DateTime?             @map("reviewed_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  createdBy    User                  @relation("PurchaseRequestCreatedBy", fields: [createdById], references: [id])
  reviewedBy   User?                 @relation("PurchaseRequestReviewedBy", fields: [reviewedById], references: [id])
  items        PurchaseRequestItem[]
  lpo          LocalPurchaseOrder?

  @@index([status])
  @@index([requestDate])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                String  @id @default(uuid())
  purchaseRequestId String  @map("purchase_request_id")
  storeItemId       String  @map("store_item_id")
  quantityRequested Decimal @map("quantity_requested") @db.Decimal(10, 3)
  estimatedUnitCost Decimal @default(0) @map("estimated_unit_cost") @db.Decimal(10, 2)
  reason            String?

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  storeItem       StoreItem       @relation(fields: [storeItemId], references: [id])

  @@map("purchase_request_items")
}

/// Local Purchase Order raised by Accountant after reviewing a PurchaseRequest
model LocalPurchaseOrder {
  id               String    @id @default(uuid())
  lpoNumber        String    @unique @map("lpo_number")
  purchaseRequestId String?  @unique @map("purchase_request_id")
  supplierId       String?   @map("supplier_id")
  supplierName     String    @map("supplier_name")
  lpoDate          DateTime  @map("lpo_date") @db.Date
  expectedDelivery DateTime? @map("expected_delivery") @db.Date
  status           LPOStatus @default(DRAFT)
  subtotalKes      Decimal   @map("subtotal_kes") @db.Decimal(12, 2)
  vatKes           Decimal   @default(0) @map("vat_kes") @db.Decimal(12, 2)
  totalKes         Decimal   @map("total_kes") @db.Decimal(12, 2)
  notes            String?
  approvedById     String?   @map("approved_by_id")
  approvedAt       DateTime? @map("approved_at")
  createdById      String    @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  supplier        Supplier?        @relation(fields: [supplierId], references: [id])
  createdBy       User             @relation("LPOCreatedBy", fields: [createdById], references: [id])
  approvedBy      User?            @relation("LPOApprovedBy", fields: [approvedById], references: [id])
  items           LPOItem[]
  stockIns        StoreStockIn[]

  @@index([status])
  @@index([lpoDate])
  @@map("local_purchase_orders")
}

model LPOItem {
  id          String  @id @default(uuid())
  lpoId       String  @map("lpo_id")
  storeItemId String?  @map("store_item_id")
  description String?
  quantity    Decimal @db.Decimal(10, 3)
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  subtotal    Decimal @db.Decimal(12, 2)

  lpo       LocalPurchaseOrder @relation(fields: [lpoId], references: [id], onDelete: Cascade)
  storeItem StoreItem?          @relation(fields: [storeItemId], references: [id])

  @@map("lpo_items")
}

// ─── PHASE 2: FARM EMPLOYEES ──────────────────────────────────────────────────


model FarmEmployee {
  id                String         @id @default(uuid())
  fullName          String         @map("full_name")
  employeeNumber    String?        @map("employee_number")
  nationalId        String?        @unique @map("national_id")
  address           String?
  workPhone         String?        @map("work_phone")
  mobilePhone       String?        @map("mobile_phone")
  phone             String?
  email             String?
  role              String
  assignment        String?
  houseIds          String[]       @map("house_ids")
  salaryKes         Decimal        @default(0) @map("salary_kes") @db.Decimal(10, 2)
  payPeriod         String         @default("MONTHLY") @map("pay_period")
  hireDate          DateTime       @map("hire_date") @db.Date
  terminatedDate    DateTime?      @map("terminated_date") @db.Date
  status            EmployeeStatus @default(ACTIVE)
  nextOfKinName     String?        @map("next_of_kin_name")
  nextOfKinPhone    String?        @map("next_of_kin_phone")
  nextOfKinRelation String?        @map("next_of_kin_relation")
  notes             String?
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@index([status])
  @@map("farm_employees")
}


// ─── PHASE 2: CONSTRUCTION RECORDS ───────────────────────────────────────────

model ConstructionRecord {
  id               String           @id @default(uuid())
  title            String
  constructionType ConstructionType @map("construction_type")
  location         String           // house code / general farm area
  startDate        DateTime         @map("start_date") @db.Date
  endDate          DateTime?        @map("end_date") @db.Date
  contractorName   String?          @map("contractor_name")
  contractorPhone  String?          @map("contractor_phone")
  budgetKes        Decimal          @default(0) @map("budget_kes") @db.Decimal(12, 2)
  actualCostKes    Decimal          @default(0) @map("actual_cost_kes") @db.Decimal(12, 2)
  status           String           @default("IN_PROGRESS") // PLANNED | IN_PROGRESS | COMPLETED | ON_HOLD
  description      String?
  notes            String?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([status])
  @@index([startDate])
  @@map("construction_records")
}

// ─── Egg Breakage Adjustment (Sales role) ─────────────────────────────────────

model EggBreakageAdjustment {
  id             String   @id @default(uuid())
  adjustmentRef  String   @unique @map("adjustment_ref")
  adjustmentDate DateTime @map("adjustment_date") @db.Date

  // NON_CONSUMABLE = broken unsellable | CONSUMABLE = broken sellable
  adjustmentType String   @map("adjustment_type")

  // Quantities at time of adjustment (snapshot from tally / stock)
  quantityStandardBefore      Int @map("quantity_standard_before")
  quantityStarterBefore       Int @map("quantity_starter_before")
  quantityNonConsumableBefore Int @map("quantity_non_consumable_before")
  quantityConsumableBefore    Int @map("quantity_consumable_before")

  // New corrected quantities (entered by Sales)
  newNonConsumable Int @map("new_non_consumable")
  newConsumable    Int @map("new_consumable")

  // Auto-calculated diff
  quantityDiff Int @map("quantity_diff")

  // Optional: reference tally session this is based on
  tallySessionId String? @map("tally_session_id")

  notes        String?
  reportedById String  @map("reported_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  reportedBy User @relation("BreakageAdjustmentReportedBy", fields: [reportedById], references: [id])

  @@index([adjustmentDate])
  @@index([adjustmentType])
  @@map("egg_breakage_adjustments")
}

// ─── Cage Map Models ──────────────────────────────────────────────────────────

model FarmBlock {
  id                  String   @id @default(uuid())
  code                String   @unique
  name                String
  isActive            Boolean  @default(true) @map("is_active")
  isUnderConstruction Boolean  @default(false) @map("is_under_construction")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  farm_sections FarmSection[]

  @@map("farm_blocks")
}

model FarmSection {
  id         String @id @default(uuid())
  blockId    String @map("block_id")
  code       String
  sortOrder  Int    @default(0) @map("sort_order")

  block     FarmBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  farm_rows FarmRow[]

  @@map("farm_sections")
}

model FarmRow {
  id        String  @id @default(uuid())
  sectionId String  @map("section_id")
  rowCode   String  @map("row_code")
  isActive  Boolean @default(true) @map("is_active")

  section     FarmSection          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  assignments BatchCageAssignment?

  @@map("farm_rows")
}

model BatchCageAssignment {
  id           String   @id @default(uuid())
  rowId        String   @unique @map("row_id")
  batchId      String   @map("batch_id")
  birdCount    Int      @default(0) @map("bird_count")
  transferDate DateTime @map("transfer_date") @db.Date
  notes        String?
  assignedById String   @map("assigned_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  row        FarmRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  batch      Batch   @relation(fields: [batchId], references: [id])
  assignedBy User    @relation("CageAssignedBy", fields: [assignedById], references: [id])

  @@map("batch_cage_assignments")
}

// ─── Simple Stock Request ─────────────────────────────────────────────────────

model SimpleStockRequest {
  id            String    @id @default(uuid())
  requestRef    String    @unique @map("request_ref")
  requestDate   DateTime  @map("request_date")
  neededBy      DateTime? @map("needed_by")
  purpose       String?
  notes         String?
  status        String    @default("PENDING") // PENDING | ISSUED | PARTIAL | REJECTED | CANCELLED
  requestedById String    @map("requested_by_id")
  fulfilledById String?   @map("fulfilled_by_id")
  fulfilledAt   DateTime? @map("fulfilled_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  requestedBy User                    @relation("SimpleStockRequestedBy", fields: [requestedById], references: [id])
  fulfilledBy User?                   @relation("SimpleStockFulfilledBy", fields: [fulfilledById], references: [id])
  items       SimpleStockRequestItem[]

  @@index([status])
  @@map("simple_stock_requests")
}

model SimpleStockRequestItem {
  id                String   @id @default(uuid())
  requestId         String   @map("request_id")
  storeItemId       String   @map("store_item_id")
  quantityRequested Decimal  @map("quantity_requested") @db.Decimal(10, 3)
  quantityIssued    Decimal? @map("quantity_issued") @db.Decimal(10, 3)
  stockOutId        String?  @unique @map("stock_out_id")
  notes             String?

  request   SimpleStockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  storeItem StoreItem          @relation(fields: [storeItemId], references: [id])
  stockOut  StoreStockOut?     @relation(fields: [stockOutId], references: [id])

  @@map("simple_stock_request_items")
}

