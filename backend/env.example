# ─── Database ─────────────────────────────────────────────────────────────────
# Railway PostgreSQL URL (from Railway dashboard after provisioning)
DATABASE_URL="postgresql://user:password@host:5432/awfms?schema=public"

# ─── Redis ────────────────────────────────────────────────────────────────────
# Railway Redis URL
REDIS_URL="redis://default:password@host:6379"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME_generate_a_64_byte_random_hex_string"

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS="http://localhost:5173,https://awfms.vercel.app"

# ─── Cloudflare R2 (vet PDF storage) ─────────────────────────────────────────
# From Cloudflare R2 dashboard
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="awfms-vet-reports"
R2_ENDPOINT="https://your_account_id.r2.cloudflarestorage.com"

# ─── Anthropic API (AI reports & alerts) ─────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# Model used for the automated cron reports (weekly performance, improvement
# suggestions, forecasts). Default is fine for these — they're short and
# frequent, so cost/speed matters more than maximum depth.
# ANTHROPIC_MODEL="claude-sonnet-4-6"

# Model used ONLY for the on-demand Director "generate report for this batch"
# button. That report now pulls every brooder data point (environment, feed
# vs required ration, mortality vs the HyLine control-standard ceiling, bird
# weight vs expected band, vaccination coverage gaps, open health events,
# treatments given) and is written to be read carefully, not skimmed — so it's
# worth pointing at Anthropic's most capable released model.
# Uncomment to use Claude Fable 5 (Anthropic's most capable generally
# available model as of July 2026 — priced roughly 2x Claude Opus 4.8, so this
# is deliberately scoped to just this one report type rather than applied
# everywhere). Requires an API key with Fable 5 access.
# ANTHROPIC_MODEL_BATCH_REPORT="claude-fable-5"

# ─── Email / Notifications (Phase 6) ─────────────────────────────────────────
# Not needed for Phase 1 — in-app notifications only
# RESEND_API_KEY="re_..."
